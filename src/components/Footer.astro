---
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="stellar-field absolute inset-0 pointer-events-none opacity-70"></div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
    <div class="footer-command">
      <div>
        <span>Arsolv' Mindset</span>
        <h2>Problemi complessi. Regia unica.</h2>
      </div>
      <a href={`${base}/contatti/`}>Avvia analisi</a>
    </div>

    <div class="footer-main">
      <div class="footer-brand">
        <a href={`${base}/`} class="footer-logo">
          <img src={`${base}/logo.jpeg`} alt="ARSOLVING" />
          <div>
            <strong><span>AR</span>SOLVING</strong>
            <small>Global Vision / Arsolv' Mindset</small>
          </div>
        </a>
        <p>
          Arsolving trasforma problemi operativi, digitali e strategici in sistemi chiari,
          integrati e gestibili.
        </p>
      </div>

      <nav class="footer-nav" aria-label="Navigazione footer">
        <span>Navigazione</span>
        <a href={`${base}/`}>Mindset</a>
        <a href={`${base}/#cosa-risolviamo`}>Cosa risolviamo</a>
        <a href={`${base}/#arsolv`}>Metodo</a>
        <a href={`${base}/il-gruppo/`}>Il Gruppo</a>
      </nav>

      <div class="footer-nav">
        <span>Dimensioni</span>
        <a href={`${base}/services/`}>Operativa</a>
        <a href={`${base}/digital/`}>Digitale</a>
        <a href={`${base}/projects/`}>Strategica</a>
      </div>

      <div class="footer-contact">
        <span>Contatto</span>
        <a href="mailto:info@arsolving.com">info@arsolving.com</a>
        <p>Per richieste operative, digitali, strategiche o miste.</p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} ARSOLVING. Tutti i diritti riservati.</p>
      <p>Premium problem solving system.</p>
    </div>
  </div>
</footer>

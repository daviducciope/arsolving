---
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const p    = Astro.url.pathname

function active(segment: string): boolean {
  if (segment === '') return p === base + '/' || p === base || p === base + '/index.html'
  return p.startsWith(base + '/' + segment)
}
---

<nav id="navbar" class="navbar-root">

  <!-- Laser line — visible scrolled -->
  <div class="navbar-laser" aria-hidden="true"></div>

  <div class="navbar-inner max-w-7xl mx-auto px-6 lg:px-12">

    <!-- ── LOGO ── -->
    <a href={`${base}/`} class="navbar-logo-link" aria-label="ARSOLVING — Home">
      <img src={`${base}/logo_arsolving_light.svg`} alt="ARSOLVING" class="navbar-logo-img" />
    </a>

    <!-- ── DESKTOP NAV ── -->
    <div class="navbar-links" role="navigation" aria-label="Navigazione principale">
      <a href={`${base}/`}             class={`nav-link ${active('') ? 'nav-link--active' : ''}`}>Home</a>
      <a href={`${base}/#interventi`}  class="nav-link">Interventi</a>
      <a href={`${base}/#aree`}        class="nav-link">Cosa facciamo</a>
      <a href={`${base}/il-gruppo/`}   class={`nav-link ${active('il-gruppo') ? 'nav-link--active' : ''}`}>Il Gruppo</a>

      <div class="nav-divider" aria-hidden="true"></div>

      <a href={`${base}/contatti/`} class="nav-cta">
        <span>Avvia analisi</span>
        <svg class="nav-cta-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- ── HAMBURGER ── -->
    <button id="hamburger"
            class="navbar-hamburger lg:hidden"
            aria-label="Apri menu"
            aria-expanded="false"
            aria-controls="mobile-menu">
      <span class="ham-line ham-line-1"></span>
      <span class="ham-line ham-line-2"></span>
      <span class="ham-line ham-line-3"></span>
    </button>

  </div>
</nav>

<!-- ── MOBILE OVERLAY ── -->
<div id="mobile-menu" class="mobile-overlay hidden" role="dialog" aria-modal="true">
  <div class="mobile-overlay-bg" aria-hidden="true"></div>
  <div class="mobile-overlay-content">

    <div class="mobile-overlay-header">
      <img src={`${base}/logo_arsolving_light.svg`} alt="ARSOLVING" class="mobile-logo-img" />
      <button onclick="document.getElementById('hamburger').click()"
              class="text-white/50 hover:text-white transition-colors p-2"
              aria-label="Chiudi menu">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M4 4l14 14M18 4L4 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <nav class="mobile-nav" aria-label="Menu mobile">
      <a href={`${base}/`}             class="mobile-nav-link"><span class="mobile-nav-num">01</span>Home</a>
      <a href={`${base}/#interventi`}  class="mobile-nav-link"><span class="mobile-nav-num">02</span>Interventi</a>
      <a href={`${base}/#aree`}        class="mobile-nav-link"><span class="mobile-nav-num">03</span>Cosa facciamo</a>
      <a href={`${base}/il-gruppo/`}   class="mobile-nav-link"><span class="mobile-nav-num">04</span>Il Gruppo</a>
    </nav>

    <div class="mobile-overlay-footer">
      <a href={`${base}/contatti/`} class="btn-gold w-full justify-center text-center py-4">
        Avvia analisi →
      </a>
      <p class="text-white/25 text-[0.65rem] tracking-[0.2em] uppercase text-center mt-4">
        Global Vision / Arsolv' Mindset
      </p>
    </div>

  </div>
</div>

<style>
/* ══ ROOT ══ */
.navbar-root {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 50;
  transition: background 0.38s ease, box-shadow 0.38s ease, border-color 0.38s ease;
  border-bottom: 1px solid transparent;
}
.navbar-root.is-scrolled {
  background: rgba(14,29,52,0.97);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  box-shadow: 0 8px 48px rgba(0,0,0,0.38);
  border-bottom-color: rgba(199,162,74,0.1);
}

/* Laser line */
.navbar-laser {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1.5px;
  background: linear-gradient(90deg,
    transparent 0%, rgba(199,162,74,0) 10%,
    rgba(199,162,74,0.9) 40%, #C7A24A 50%,
    rgba(199,162,74,0.9) 60%, rgba(199,162,74,0) 90%, transparent 100%);
  opacity: 0;
  transition: opacity 0.4s ease;
}
.navbar-root.is-scrolled .navbar-laser { opacity: 1; }

/* Inner row */
.navbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 6rem;
  transition: height 0.38s ease;
}
.navbar-root.is-scrolled .navbar-inner { height: 4.25rem; }

/* ══ LOGO ══ */
.navbar-logo-link {
  display: block;
  flex-shrink: 0;
  text-decoration: none;
  transition: opacity 0.2s ease;
}
.navbar-logo-link:hover { opacity: 0.88; }

.navbar-logo-img {
  display: block;
  height: 52px;
  width: auto;
  transition: height 0.38s ease;
}
.navbar-root.is-scrolled .navbar-logo-img { height: 36px; }

.mobile-logo-img {
  display: block;
  height: 36px;
  width: auto;
}

/* ══ DESKTOP LINKS ══ */
.navbar-links {
  display: none;
  align-items: center;
  gap: 0.15rem;
}
@media (min-width: 1024px) { .navbar-links { display: flex; } }

.nav-link {
  position: relative;
  padding: 0.45rem 0.85rem;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.52);
  text-decoration: none;
  transition: color 0.22s ease;
}
.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0; left: 50%; right: 50%;
  height: 1px;
  background: #C7A24A;
  transition: left 0.25s ease, right 0.25s ease;
}
.nav-link:hover,
.nav-link--active { color: rgba(255,255,255,0.95); }
.nav-link:hover::after,
.nav-link--active::after { left: 0.85rem; right: 0.85rem; }
.nav-link--active { color: #C7A24A; }
.nav-link--active::after { background: #C7A24A; }

.nav-divider {
  width: 1px; height: 1.25rem;
  background: rgba(255,255,255,0.1);
  margin: 0 0.5rem;
}

.nav-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.6rem 1.3rem;
  background: #C7A24A;
  color: #0E1D34;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  border-radius: 2px;
  text-decoration: none;
  transition: background 0.22s ease, box-shadow 0.22s ease, transform 0.2s ease;
}
.nav-cta:hover {
  background: #D4B464;
  transform: translateY(-1px);
  box-shadow: 0 4px 22px rgba(199,162,74,0.35);
}
.nav-cta-arrow { width: 14px; height: 14px; transition: transform 0.22s ease; }
.nav-cta:hover .nav-cta-arrow { transform: translateX(3px); }

/* ══ HAMBURGER ══ */
.navbar-hamburger {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 2.4rem; height: 2.4rem;
  padding: 0.3rem;
  background: transparent;
  border: none;
  cursor: pointer;
}
@media (min-width: 1024px) {
  .navbar-hamburger { display: none; }
}
.ham-line {
  display: block;
  height: 1.5px;
  background: white;
  border-radius: 1px;
  transform-origin: center;
  transition: transform 0.28s ease, opacity 0.28s ease, width 0.28s ease;
}
.ham-line-1 { width: 22px; }
.ham-line-2 { width: 22px; }
.ham-line-3 { width: 14px; }
.navbar-hamburger.menu-open .ham-line-1 { transform: translateY(6.5px) rotate(45deg); width: 22px; }
.navbar-hamburger.menu-open .ham-line-2 { opacity: 0; transform: scaleX(0); }
.navbar-hamburger.menu-open .ham-line-3 { transform: translateY(-6.5px) rotate(-45deg); width: 22px; }

/* ══ MOBILE OVERLAY ══ */
.mobile-overlay {
  position: fixed; inset: 0;
  z-index: 80;
  display: flex; flex-direction: column;
}
.mobile-overlay.hidden { display: none; }
.mobile-overlay-bg {
  position: absolute; inset: 0;
  background: rgba(14,29,52,0.98);
  backdrop-filter: blur(24px);
}
.mobile-overlay-content {
  position: relative; z-index: 1;
  display: flex; flex-direction: column;
  height: 100%;
  padding: 0 1.5rem 2rem;
}
.mobile-overlay-header {
  display: flex; align-items: center; justify-content: space-between;
  height: 5rem;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  margin-bottom: 2rem;
}
.mobile-nav { flex: 1; display: flex; flex-direction: column; }
.mobile-nav-link {
  display: flex; align-items: center; gap: 1rem;
  padding: 1.1rem 0;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  color: rgba(255,255,255,0.62);
  font-family: var(--font-display,'Bebas Neue',sans-serif);
  font-size: clamp(2rem, 8vw, 3rem);
  letter-spacing: 0.06em;
  text-decoration: none; text-transform: uppercase;
  transition: color 0.2s ease;
}
.mobile-nav-link:hover { color: white; }
.mobile-nav-num {
  font-family: var(--font-body,'Manrope',sans-serif);
  font-size: 0.6rem; font-weight: 700;
  letter-spacing: 0.2em;
  color: rgba(199,162,74,0.5);
  margin-top: 0.35rem; flex-shrink: 0;
}
.mobile-overlay-footer {
  padding-top: 2rem;
  border-top: 1px solid rgba(255,255,255,0.06);
}
</style>

<script src="../scripts/nav.js"></script>

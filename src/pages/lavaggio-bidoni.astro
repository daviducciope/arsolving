---
import Base from '../layouts/Base.astro'
import { Image } from 'astro:assets'
import imgDetergent from '../../assets/arsolving-detergent.png'
import imgPool from '../../assets/arsolving-man-at-work-with-pool.png'
import imgWork from '../../assets/img-arsolving-man-at-work.png'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const areas = [
  'Montesilvano', 'Pescara', 'Spoltore', "Città Sant'Angelo",
  'Francavilla al Mare', 'Cepagatti', 'San Giovanni Teatino',
  'Cappelle sul Tavo', 'Silvi', 'Chieti',
]

const pillars = [
  {
    title: 'Prodotti a base di enzimi',
    desc: 'Igienizziamo e detergiamo in modo naturale con un sistema a base di enzimi: degrada lo sporco organico e neutralizza i batteri, senza solventi aggressivi.',
    icon: 'M12 3c-1.5 4-6 5.5-6 10a6 6 0 0012 0c0-4.5-4.5-6-6-10z',
  },
  {
    title: 'Non sporca nulla',
    desc: 'Sistema a ciclo chiuso: l\'acqua di lavaggio viene recuperata e trattata. Niente residui a terra, niente cattivi odori, nessun disagio per te o per i vicini.',
    icon: 'M12 2.25c-4.97 0-9 4.03-9 9 0 6 9 10.5 9 10.5s9-4.5 9-10.5c0-4.97-4.03-9-9-9zm0 12a3 3 0 110-6 3 3 0 010 6z',
  },
  {
    title: 'Conformi alle normative',
    desc: 'Operatori qualificati e attrezzatura professionale. Prodotti biodegradabili e procedure tracciate, nel pieno rispetto delle normative ambientali.',
    icon: 'M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
]

const faqs = [
  {
    q: 'In quali zone fate il lavaggio bidoni a domicilio?',
    a: 'Operiamo a Montesilvano, Pescara e nei comuni limitrofi: Spoltore, Città Sant\'Angelo, Francavilla al Mare, Cepagatti, San Giovanni Teatino, Cappelle sul Tavo, Silvi e Chieti. Se il tuo comune non è in elenco scrivici lo stesso: valutiamo ogni richiesta nell\'area di Pescara e Chieti.',
  },
  {
    q: 'Rischiate di sporcare davanti casa?',
    a: 'No. Lavoriamo con un sistema a ciclo chiuso che recupera l\'acqua di lavaggio: non resta nulla a terra e nessun residuo nelle vicinanze.',
  },
  {
    q: 'Quali prodotti usate?',
    a: 'Utilizziamo prodotti a base di enzimi, naturali, biodegradabili e sicuri per persone, animali e ambiente. Niente sostanze aggressive.',
  },
  {
    q: 'Devo essere presente durante il lavaggio?',
    a: 'No, non è necessario. È sufficiente che il bidone sia accessibile all\'orario concordato. Al termine ti inviamo conferma dell\'intervento.',
  },
  {
    q: 'Quanto costa il servizio?',
    a: 'Il servizio parte da 20€ + IVA per il singolo bidone domestico (2 ruote). Per condomini, grandi formati (4 ruote), lavaggio completo dell\'isola ecologica o servizi periodici ricorrenti formuliamo un preventivo su misura con tariffe dedicate e sconti volume.',
  },
  {
    q: 'Lavate anche l\'isola ecologica del condominio?',
    a: 'Sì. Oltre ai singoli bidoni laviamo e sanifichiamo l\'intera piazzola di raccolta ad alta pressione: pavimento, pareti e cassonetti. Il servizio viene concordato su preventivo dedicato in base alla superficie e allo stato dell\'area.',
  },
  {
    q: 'Posso programmare lavaggi periodici?',
    a: 'Sì. Per condomini, attività e clienti che vogliono un calendario ricorrente (settimanale, quindicinale o mensile) prepariamo un piano su misura con tariffe dedicate.',
  },
]
---

<Base title="Lavaggio Bidoni a Domicilio a Montesilvano e Pescara"
      description="Lavaggio e sanificazione bidoni a domicilio a Montesilvano, Pescara e zone limitrofe da 20€ + IVA. Sistema a base di enzimi che igienizza senza sporcare. Anche isole ecologiche e cassonetti condominiali.">

  <!-- Hero -->
  <div class="page-hero">
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-14 items-center">
        <div>
          <div class="section-label mb-7">Montesilvano · Pescara · zone limitrofe</div>
          <h1 class="font-display uppercase text-white leading-[0.9] mb-5"
              style="font-size: clamp(2.4rem, 6vw, 5.6rem);">
            Lavaggio e Sanificazione<br />Bidoni e Isole Ecologiche
          </h1>
          <p class="text-[1rem] text-white/66 leading-[1.8] max-w-2xl mb-9">
            Igienizziamo e sanifichiamo <strong class="text-white/85">bidoni, cassonetti e isole ecologiche</strong> a domicilio a <strong class="text-white/85">Montesilvano, Pescara e dintorni</strong>, con un sistema a base di enzimi a ciclo chiuso che deterge in modo naturale, <strong class="text-white/85">senza sporcare nulla</strong>.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="#prenota" class="btn-gold">Prenota un sopralluogo</a>
          </div>
        </div>

        <!-- Immagine hero: solo desktop, non aggiunge altezza su mobile -->
        <div class="hidden lg:block rounded-sm overflow-hidden aspect-[4/3] border border-white/12">
          <Image src={imgWork} alt="Operatore ARSOLVING durante il lavaggio e la sanificazione dei bidoni a domicilio"
                 widths={[500, 760]} sizes="480px"
                 loading="lazy" decoding="async"
                 class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </div>


  <!-- Pilastri -->
  <section class="py-24 bg-white border-b border-navy/12">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {pillars.map((p, i) => (
          <div class={`reveal delay-${(i % 3) + 1} service-card group`}>
            <div class="w-11 h-11 bg-navy rounded-sm flex items-center justify-center text-gold mb-5
                        group-hover:bg-gold group-hover:text-navy transition-colors duration-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={p.icon}/>
              </svg>
            </div>
            <h3 class="font-heading font-semibold text-navy text-[1.05rem] mb-3">{p.title}</h3>
            <p class="text-[0.86rem] text-navy/70 leading-[1.78]">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- Tecnologia enzimatica -->
  <section class="py-24 bg-navy">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <div class="reveal">
          <div class="section-label mb-6">Tecnologia</div>
          <h2 class="font-display uppercase text-white leading-[0.92] mb-6"
              style="font-size: clamp(2.2rem, 4.5vw, 4.5rem);">
            Sanificazione<br />a base di enzimi
          </h2>
          <p class="text-white/66 text-[1rem] leading-[1.85]">
            Gli enzimi degradano lo sporco organico e neutralizzano i batteri là dove
            si annidano i cattivi odori. Un sistema naturale ed efficace, che lavora
            senza solventi aggressivi e con acqua recuperata a fine ciclo.
          </p>
        </div>

        <div class="reveal delay-2 rounded-sm overflow-hidden aspect-[3/2] border border-white/12">
          <Image src={imgDetergent} alt="Detergente enzimatico biodegradabile usato da ARSOLVING per igienizzare i bidoni"
                 widths={[400, 600, 900]} sizes="(min-width: 1024px) 540px, 100vw"
                 loading="lazy" decoding="async"
                 class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>


  <!-- Servizio Completo & Tariffe (Unificato) -->
  <section id="prezzi" class="py-24 bg-off-white border-b border-navy/12">
    <div class="max-w-6xl mx-auto px-6 lg:px-10">
      <div class="reveal mb-12 text-center">
        <div class="section-label section-label--dark mb-5 justify-center">Tariffe &amp; Servizi</div>
        <h2 class="font-display uppercase text-navy leading-[0.92]"
            style="font-size: clamp(2.2rem, 4.5vw, 4.2rem);">
          Lavaggio Bidoni e Isola Ecologica
        </h2>
      </div>

      <!-- Immagine del servizio -->
      <div class="reveal mb-12 rounded-sm overflow-hidden aspect-[21/9] border border-navy/12">
        <Image src={imgPool} alt="Operatore ARSOLVING durante il lavaggio ad alta pressione dell'isola ecologica"
               widths={[600, 900, 1200]} sizes="(min-width: 1024px) 1040px, 100vw"
               loading="lazy" decoding="async"
               class="w-full h-full object-cover" />
      </div>

      <!-- Griglia 2 colonne: Valore / Isola Ecologica a sinistra, Card Prezzo Civetta a destra -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- Colonna Sinistra (7 col): Il servizio completo -->
        <div class="reveal lg:col-span-7 bg-white p-8 sm:p-10 border border-navy/12 rounded-sm flex flex-col justify-between">
          <div>
            <div class="section-label section-label--dark mb-4">Intervento Completo</div>
            <h3 class="font-display uppercase text-navy text-[1.6rem] sm:text-[2rem] leading-[1.05] mb-4">
              Igiene totale: dal singolo bidone all'intera piazzola
            </h3>
            <p class="text-navy/75 text-[0.98rem] leading-[1.8] mb-6">
              Non ci limitiamo ai soli bidoni: laviamo e sanifichiamo l'intera piazzola di raccolta ad alta pressione con sistema enzimatico a ciclo chiuso, compresi cassonetti e contenitori condominiali. Rimuoviamo lo sporco ostinato a terra e sulle pareti, neutralizziamo i cattivi odori e restituiamo un'area salubre, decorosa e perfettamente in ordine.
            </p>

            <ul class="space-y-3.5 mb-6">
              <li class="flex items-start gap-3 text-[0.92rem] text-navy/80">
                <svg class="w-5 h-5 text-gold flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                <span><strong>Bidoni 2 e 4 ruote:</strong> lavaggio interno ed esterno con disinfezione enzimatica naturale.</span>
              </li>
              <li class="flex items-start gap-3 text-[0.92rem] text-navy/80">
                <svg class="w-5 h-5 text-gold flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                <span><strong>Piazzola e isola ecologica:</strong> rimozione macchie, incrostazioni e sanificazione pavimentazione.</span>
              </li>
              <li class="flex items-start gap-3 text-[0.92rem] text-navy/80">
                <svg class="w-5 h-5 text-gold flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                <span><strong>Ciclo chiuso senza sporcare:</strong> acqua recuperata e nessun residuo davanti casa o nel cortile.</span>
              </li>
            </ul>
          </div>

          <div class="pt-5 border-t border-navy/8">
            <span class="inline-block font-heading text-[0.84rem] uppercase tracking-wider font-bold text-navy/70">
              Ideale per: condomini, abitazioni private e attività commerciali
            </span>
          </div>
        </div>

        <!-- Colonna Destra (5 col): Card Prezzo Civetta + CTA Form -->
        <div class="reveal delay-1 lg:col-span-5 price-card price-card--feature p-8 sm:p-10 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="block text-gold text-[0.72rem] tracking-[0.22em] uppercase font-bold">
                Tariffa d'ingresso
              </span>
              <span class="bg-gold/15 text-navy text-[0.72rem] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">
                Base
              </span>
            </div>

            <div class="mb-5">
              <div class="flex items-baseline gap-2">
                <span class="text-navy/55 text-[1rem] font-semibold">a partire da</span>
                <span class="font-display text-navy text-[3.8rem] sm:text-[4.2rem] leading-none">20€</span>
                <span class="text-navy/55 text-[0.9rem] font-medium">+ IVA</span>
              </div>
              <p class="text-navy/65 text-[0.85rem] mt-1.5">
                Tariffa di partenza per singolo bidone domestico (2 ruote).
              </p>
            </div>

            <div class="p-4 bg-navy/5 border border-navy/10 rounded-sm mb-6 space-y-2">
              <p class="text-[0.88rem] text-navy/85 leading-[1.6]">
                <strong>Sei un condominio o hai più bidoni?</strong>
              </p>
              <p class="text-[0.82rem] text-navy/70 leading-[1.6]">
                Per formati a 4 ruote, servizi periodici (settimanali/quindicinali/mensili) o inclusione dell'isola ecologica formuliamo un <strong>preventivo dedicato con sconti volume</strong> su misura.
              </p>
            </div>
          </div>

          <div>
            <a href="#prenota" class="btn-gold w-full text-center justify-center py-3.5 text-[0.82rem]">
              Richiedi preventivo gratuito →
            </a>
            <p class="text-center text-navy/50 text-[0.75rem] mt-3">
              Sopralluogo e preventivo senza alcun impegno
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- Dove operiamo -->
  <section class="py-24 bg-white border-b border-navy/12">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 text-center">
      <div class="reveal">
        <div class="section-label section-label--dark mb-5 justify-center">Zone servite</div>
        <h2 class="font-display uppercase text-navy leading-[0.92] mb-6"
            style="font-size: clamp(2rem, 4vw, 4rem);">
          Lavaggio bidoni a Montesilvano,<br />Pescara e zone limitrofe
        </h2>
        <p class="text-navy/72 text-[1rem] leading-[1.85] max-w-2xl mx-auto mb-10">
          Operiamo con il servizio di lavaggio e sanificazione bidoni a domicilio in
          tutta l'area metropolitana di Pescara. Raggiungiamo abitazioni, attività
          commerciali e condomini in città e nei comuni vicini.
        </p>
      </div>

      <ul class="reveal delay-1 flex flex-wrap justify-center gap-2.5" aria-label="Comuni serviti">
        {areas.map((a) => (
          <li class="area-chip">{a}</li>
        ))}
      </ul>

      <p class="reveal delay-2 text-navy/55 text-[0.88rem] mt-8">
        Il tuo comune non è in elenco? <a href="#prenota" class="text-gold font-semibold hover:underline">Scrivici lo stesso</a>:
        valutiamo ogni richiesta nella zona di Pescara, Chieti e Teramo.
      </p>
    </div>
  </section>


  <!-- Comuni ed enti / MePA -->
  <section class="py-16 bg-off-white border-b border-navy/12">
    <div class="max-w-5xl mx-auto px-6 lg:px-10">
      <div class="reveal flex flex-col md:flex-row md:items-center gap-6 md:gap-10">

        <svg class="w-10 h-10 text-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>

        <div class="flex-1">
          <strong class="block font-heading font-semibold text-navy text-[1.15rem] mb-2">
            Sei un comune o un ente pubblico?
          </strong>
          <p class="text-navy/72 text-[0.93rem] leading-[1.8]">
            ARSOLVING è un'impresa abilitata al <strong class="font-semibold text-navy">MePA</strong>,
            il Mercato Elettronico della Pubblica Amministrazione: puoi affidarci il servizio
            direttamente sul portale, senza procedura di gara.
          </p>
        </div>

        <a href={`${base}/contatti/`} class="btn-outline-navy flex-shrink-0 self-start md:self-auto">
          Riferimenti MePA
        </a>

      </div>
    </div>
  </section>


  <!-- Form prenotazione -->
  <section id="prenota" class="relative overflow-hidden bg-navy pt-24 pb-28">
    <div class="relative max-w-3xl mx-auto px-6 lg:px-10">

        <!-- Form -->
        <div class="reveal">
          <form id="booking-form" class="analysis-form" novalidate>
            <div class="mb-7">
              <h3 class="font-display uppercase text-white leading-[0.92]"
                  style="font-size: clamp(1.7rem, 3.5vw, 2.6rem);">
                Richiedi un preventivo gratuito.
              </h3>
            </div>

            <!-- Honeypot anti-spam -->
            <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
              <label>Sito web (lascia vuoto)
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div class="form-row">
              <label>
                <span>Bidoni 2 ruote (da 20€ / piccolo formato)</span>
                <input type="number" name="bidoni2" min="0" max="50" value="1" />
              </label>
              <label>
                <span>Bidoni 4 ruote (grande formato / condominiale)</span>
                <input type="number" name="bidoni4" min="0" max="50" value="0" />
              </label>
            </div>

            <!-- Isola ecologica -->
            <label class="isola-toggle">
              <input type="checkbox" name="isola" value="si" />
              <span class="isola-toggle-box">
                <strong>Aggiungi lavaggio isola ecologica</strong>
                <em>Sanificazione piazzola, pareti e cassonetti — su preventivo dedicato</em>
              </span>
            </label>

            <div class="form-row">
              <label>
                <span>Nome e cognome</span>
                <input type="text" name="nome" placeholder="Nome e cognome" required />
              </label>
              <label>
                <span>Telefono</span>
                <input type="tel" name="telefono" placeholder="+39" required />
              </label>
            </div>

            <label>
              <span>Email</span>
              <input type="email" name="email" placeholder="nome@dominio.it" required />
            </label>

            <label>
              <span>Indirizzo del lavaggio</span>
              <input type="text" name="indirizzo" placeholder="Via, numero civico, città" required />
            </label>

            <button type="submit">Richiedi sopralluogo / informazioni →</button>

            <p id="booking-feedback" class="form-feedback mt-4" role="status" aria-live="polite"></p>

            <p class="form-note mt-4">
              Ti ricontattiamo per valutare la richiesta e inserirti nel calendario di partenza — <strong>info@arsolving.it</strong>
            </p>
          </form>
        </div>

    </div>
  </section>


  <!-- FAQ -->
  <section class="py-24 bg-off-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-10">
      <div class="reveal mb-12 text-center">
        <div class="section-label section-label--dark mb-5 justify-center">Domande frequenti</div>
        <h2 class="font-display uppercase text-navy leading-[0.92]"
            style="font-size: clamp(2rem, 4vw, 4rem);">
          Le domande più comuni
        </h2>
      </div>

      <div class="flex flex-col">
        {faqs.map((f, i) => (
          <details class={`faq-item reveal delay-${(i % 3) + 1}`}>
            <summary>
              <span>{f.q}</span>
              <svg class="faq-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>


  <!-- JSON-LD Service + LocalBusiness + Breadcrumb + FAQ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Lavaggio e sanificazione bidoni a domicilio",
    "name": "Lavaggio e sanificazione bidoni a domicilio e isole ecologiche",
    "description": "Lavaggio, sanificazione e igienizzazione di bidoni, cassonetti e isole ecologiche a domicilio a Montesilvano, Pescara e zone limitrofe, con sistema a base di enzimi.",
    "category": "Pulizia e sanificazione",
    "url": "https://arsolving.it/lavaggio-bidoni/",
    "provider": {
      "@type": "LocalBusiness",
      "name": "ARSOLVING Multiservice Group",
      "image": "https://arsolving.it/og-image.png",
      "url": "https://arsolving.it",
      "email": "info@arsolving.it",
      "priceRange": "€€",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Strada della Bonifica 48/1",
        "addressLocality": "Pescara",
        "postalCode": "65129",
        "addressRegion": "PE",
        "addressCountry": "IT"
      },
      "areaServed": areas.map(a => ({ "@type": "City", "name": a }))
    },
    "areaServed": areas.map(a => ({ "@type": "City", "name": a })),
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Lavaggio bidoni e isole ecologiche",
      "itemListElement": [
        {
          "@type": "Offer",
          "name": "Lavaggio e sanificazione bidoni a domicilio",
          "priceCurrency": "EUR",
          "priceSpecification": {
            "@type": "PriceSpecification",
            "minPrice": "20",
            "priceCurrency": "EUR"
          }
        }
      ]
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://arsolving.it/" },
      { "@type": "ListItem", "position": 2, "name": "Lavaggio Bidoni a Domicilio", "item": "https://arsolving.it/lavaggio-bidoni/" }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />

  <script is:inline define:vars={{ endpoint: import.meta.env.PUBLIC_CONTACT_ENDPOINT || '' }}>
    (function () {
      const form = document.getElementById('booking-form');
      if (!form) return;

      const PRICE_2 = 20, PRICE_4 = 25, VAT = 1.22;
      const totalEl = document.getElementById('price-total');
      const isolaNote = document.getElementById('price-isola-note');
      const feedback = document.getElementById('booking-feedback');
      const btn = form.querySelector('button[type=submit]');
      const originalBtnText = btn ? btn.textContent : '';
      const ENDPOINT = endpoint || 'https://ks1sbfw0j8.execute-api.eu-central-1.amazonaws.com/contact';

      const fmt = (n) => n.toLocaleString('it-IT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

      const calc = () => {
        const b2 = Math.max(0, parseInt(form.bidoni2.value, 10) || 0);
        const b4 = Math.max(0, parseInt(form.bidoni4.value, 10) || 0);
        const isola = form.isola.checked;
        const total = (b2 * PRICE_2 + b4 * PRICE_4) * VAT;
        if (totalEl) totalEl.textContent = fmt(total);
        if (isolaNote) isolaNote.hidden = !isola;
        return { b2, b4, isola, total };
      };

      form.bidoni2.addEventListener('input', calc);
      form.bidoni4.addEventListener('input', calc);
      form.isola.addEventListener('change', calc);
      calc();

      const setFeedback = (msg, type) => {
        if (!feedback) return;
        feedback.textContent = msg || '';
        feedback.dataset.state = type || '';
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!btn) return;

        const { b2, b4, isola, total } = calc();
        const data = Object.fromEntries(new FormData(form).entries());

        if ((b2 + b4) < 1 && !isola) {
          setFeedback('Indica almeno un bidone o seleziona il lavaggio isola ecologica.', 'error');
          return;
        }
        if (!data.nome || !data.email || !data.telefono || !data.indirizzo) {
          setFeedback('Compila Nome, Telefono, Email e Indirizzo.', 'error');
          return;
        }

        const b2Cost = b2 * PRICE_2;
        const b4Cost = b4 * PRICE_4;
        const subtotal = b2Cost + b4Cost;
        const ivaAmount = Math.round((subtotal * 0.22) * 100) / 100;
        const totalWithVat = total;

        data.tipo = 'lavaggio-bidoni';
        data.servizio = isola
          ? 'Lavaggio bidoni a domicilio + isola ecologica (preventivo)'
          : 'Lavaggio bidoni a domicilio';
        data.contesto = data.servizio;
        data.bidoni2 = b2;
        data.bidoni4 = b4;
        data.costo_b2 = fmt(b2Cost);
        data.costo_b4 = fmt(b4Cost);
        data.subtotale = fmt(subtotal);
        data.iva = fmt(ivaAmount);
        data.totale_ivato = fmt(totalWithVat);
        data.isola_ecologica = isola ? 'Sì — preventivo dedicato' : 'No';
        data.importo_stimato = totalWithVat > 0 ? `a partire da ${fmt(totalWithVat)}` : 'su preventivo';

        data.problema =
`• INDIRIZZO INTERVENTO:
  ${data.indirizzo}

• RIEPILOGO VOCI & CALCOLO PREVENTIVO:
  - Bidoni 2 ruote: ${b2} unità × ${PRICE_2}€ = ${fmt(b2Cost)} + IVA
  - Bidoni 4 ruote: ${b4} unità × ${PRICE_4}€ = ${fmt(b4Cost)} + IVA
  - Isola ecologica: ${isola ? 'SÌ (richiesto sopralluogo / preventivo dedicato)' : 'NO (non richiesta)'}

• BASE ECONOMICA SUGGERITA PER TRATTATIVA:
  - Subtotale imponibile: ${fmt(subtotal)} + IVA
  - IVA (22%): ${fmt(ivaAmount)}
  - TOTALE IVATO SUGGERITO: ${fmt(totalWithVat)}
${isola ? '  (Nota: l\'isola ecologica va aggiunta a parte dopo sopralluogo, consigliato da 49€ + IVA)' : ''}`;

        btn.disabled = true;
        btn.textContent = 'Invio in corso…';
        setFeedback('', '');

        try {
          const res = await fetch(ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          const payload = await res.json().catch(() => ({}));
          if (!res.ok || !payload.success) {
            throw new Error(payload.error || 'Errore di rete. Riprova.');
          }
          form.reset();
          calc();
          btn.textContent = 'Richiesta inviata ✓';
          btn.style.background = '#16a34a';
          setFeedback('Grazie! Ti ricontattiamo a breve per valutare la richiesta e inserirti nel calendario di partenza.', 'success');
          setTimeout(() => {
            btn.textContent = originalBtnText;
            btn.disabled = false;
            btn.style.background = '';
          }, 4000);
        } catch (err) {
          console.error('booking form error:', err);
          btn.disabled = false;
          btn.textContent = originalBtnText;
          setFeedback(err.message || 'Si è verificato un errore. Riprova o scrivi a info@arsolving.it', 'error');
        }
      });
    })();
  </script>


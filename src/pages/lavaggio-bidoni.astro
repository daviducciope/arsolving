---
import Base from '../layouts/Base.astro'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const areas = [
  'Montesilvano', 'Pescara', 'Spoltore', "Città Sant'Angelo",
  'Francavilla al Mare', 'Cepagatti', 'San Giovanni Teatino',
  'Cappelle sul Tavo', 'Silvi', 'Chieti',
]

const pillars = [
  {
    title: 'Prodotti a base di enzimi',
    desc: 'Igienizziamo e detergiamo in modo naturale con un sistema a base di enzimi: degrada lo sporco organico e neutralizza i batteri, senza solventi aggressivi.',
    icon: 'M12 3c-1.5 4-6 5.5-6 10a6 6 0 0012 0c0-4.5-4.5-6-6-10z',
  },
  {
    title: 'Non sporca nulla',
    desc: 'Sistema a ciclo chiuso: l\'acqua di lavaggio viene recuperata e trattata. Niente residui a terra, niente cattivi odori, nessun disagio per te o per i vicini.',
    icon: 'M12 2.25c-4.97 0-9 4.03-9 9 0 6 9 10.5 9 10.5s9-4.5 9-10.5c0-4.97-4.03-9-9-9zm0 12a3 3 0 110-6 3 3 0 010 6z',
  },
  {
    title: 'Conformi alle normative',
    desc: 'Operatori qualificati e attrezzatura professionale. Prodotti biodegradabili e procedure tracciate, nel pieno rispetto delle normative ambientali.',
    icon: 'M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
]

const steps = [
  { n: '01', title: 'Invii la richiesta', desc: 'Compili il form indicando numero di bidoni e indirizzo. Ti ricontattiamo per valutare la richiesta e inserirti nel calendario di partenza.' },
  { n: '02', title: 'Arriviamo a domicilio', desc: 'Il nostro operatore raggiunge il tuo indirizzo con l\'attrezzatura professionale. Non devi essere presente: basta che i bidoni siano accessibili.' },
  { n: '03', title: 'Laviamo e sanifichiamo', desc: 'Lavaggio interno ed esterno con sistema enzimatico ad alta pressione. Eliminiamo germi, larve, residui e cattivi odori.' },
  { n: '04', title: 'Bidone come nuovo', desc: 'Bidone igienizzato, asciutto e profumato. Acqua recuperata, zero sporco lasciato sul posto.' },
]

const faqs = [
  {
    q: 'In quali zone fate il lavaggio bidoni a domicilio?',
    a: 'Operiamo a Montesilvano, Pescara e nei comuni limitrofi: Spoltore, Città Sant\'Angelo, Francavilla al Mare, Cepagatti, San Giovanni Teatino, Cappelle sul Tavo, Silvi e Chieti. Se il tuo comune non è in elenco scrivici lo stesso: valutiamo ogni richiesta nell\'area di Pescara e Chieti.',
  },
  {
    q: 'Rischiate di sporcare davanti casa?',
    a: 'No. Lavoriamo con un sistema a ciclo chiuso che recupera l\'acqua di lavaggio: non resta nulla a terra e nessun residuo nelle vicinanze.',
  },
  {
    q: 'Quali prodotti usate?',
    a: 'Utilizziamo prodotti a base di enzimi, naturali, biodegradabili e sicuri per persone, animali e ambiente. Niente sostanze aggressive.',
  },
  {
    q: 'Devo essere presente durante il lavaggio?',
    a: 'No, non è necessario. È sufficiente che il bidone sia accessibile all\'orario concordato. Al termine ti inviamo conferma dell\'intervento.',
  },
  {
    q: 'Quanto costa il servizio?',
    a: 'Bidone a 2 ruote (domestico): 15€ + IVA. Bidone a 4 ruote (grande/condominiale): 25€ + IVA. Per servizi periodici o condominiali prepariamo un preventivo dedicato.',
  },
  {
    q: 'Lavate anche l\'isola ecologica del condominio?',
    a: 'Sì. Oltre ai singoli bidoni laviamo e sanifichiamo l\'intera piazzola di raccolta ad alta pressione: pavimento, pareti e contenitori. Il prezzo parte da 49€ + IVA e viene definito con un preventivo dedicato in base a superficie e stato dell\'area.',
  },
  {
    q: 'Posso programmare lavaggi periodici?',
    a: 'Sì. Per condomini, attività e clienti che vogliono un calendario ricorrente (settimanale, quindicinale o mensile) prepariamo un piano su misura con tariffe dedicate.',
  },
]
---

<Base title="Lavaggio Bidoni a Domicilio a Montesilvano e Pescara"
      description="Lavaggio e sanificazione bidoni a domicilio a Montesilvano, Pescara e zone limitrofe. Sistema a base di enzimi che igienizza senza sporcare. Anche isole ecologiche e cassonetti condominiali. Servizio in attivazione: richiedi un sopralluogo o entra nella lista prioritaria."
      noindex={true}>

  <!-- Fascia: servizio in fase di attivazione -->
  <div id="activation-banner" class="activation-banner">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-3 flex items-start gap-3">
      <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008M12 3a9 9 0 100 18 9 9 0 000-18z"/>
      </svg>
      <p class="text-[0.8rem] sm:text-[0.86rem] font-heading leading-[1.55]">
        <strong class="font-bold uppercase tracking-wide">Servizio in fase di attivazione</strong>
        — stiamo raccogliendo le prime richieste per Montesilvano, Pescara e zone limitrofe.
        Richiedi ora un sopralluogo o entra nella lista prioritaria.
      </p>
    </div>
  </div>

  <script is:inline>
    (function () {
      const banner = document.getElementById('activation-banner');
      if (!banner) return;
      const setH = () => document.documentElement.style.setProperty('--activation-h', banner.offsetHeight + 'px');
      setH();
      window.addEventListener('resize', setH);
      window.addEventListener('load', setH);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(setH);
    })();
  </script>

  <!-- Hero -->
  <div class="page-hero">
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <div class="section-label mb-7">Montesilvano · Pescara · zone limitrofe</div>
      <h1 class="font-display uppercase text-white leading-[0.9] mb-5"
          style="font-size: clamp(2.4rem, 6vw, 5.6rem);">
        Lavaggio e Sanificazione<br />Bidoni a Domicilio
      </h1>
      <p class="hero-claim text-gold font-display uppercase leading-[1.05] mb-6"
         style="font-size: clamp(1.1rem, 2.4vw, 1.7rem);">
        Il problema non è il bidone.<br />È l'odore che lascia.
      </p>
      <p class="text-[1rem] text-white/66 leading-[1.8] max-w-2xl mb-9">
        Eliminiamo uno dei problemi più fastidiosi di condomini e attività:
        <strong class="text-white/85">bidoni sporchi, odori e aree rifiuti trascurate</strong>.
        Igienizziamo e sanifichiamo a domicilio a
        <strong class="text-white/85">Montesilvano, Pescara e dintorni</strong>,
        con un sistema a base di enzimi che deterge in modo naturale, a ciclo chiuso,
        <strong class="text-white/85">senza sporcare nulla</strong>. Per condomini e
        attività laviamo anche cassonetti e l'intera
        <strong class="text-white/85">isola ecologica</strong> ad alta pressione.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="#prenota" class="btn-gold">Entra nella lista prioritaria</a>
        <a href="#prenota" class="btn-ghost-light">Richiedi sopralluogo gratuito</a>
      </div>
    </div>
  </div>


  <!-- Pilastri -->
  <section class="py-24 bg-white border-b border-navy/12">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {pillars.map((p, i) => (
          <div class={`reveal delay-${(i % 3) + 1} service-card group`}>
            <div class="w-11 h-11 bg-navy rounded-sm flex items-center justify-center text-gold mb-5
                        group-hover:bg-gold group-hover:text-navy transition-colors duration-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={p.icon}/>
              </svg>
            </div>
            <h3 class="font-heading font-semibold text-navy text-[1.05rem] mb-3">{p.title}</h3>
            <p class="text-[0.86rem] text-navy/70 leading-[1.78]">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- Come funziona -->
  <section class="py-24 bg-off-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="reveal mb-14 text-center">
        <div class="section-label section-label--dark mb-5 justify-center">Come funziona</div>
        <h2 class="font-display uppercase text-navy leading-[0.92]"
            style="font-size: clamp(2rem, 4vw, 4rem);">
          Quattro passaggi, zero pensieri
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {steps.map((s, i) => (
          <div class={`reveal delay-${(i % 4) + 1} service-card`}>
            <span class="font-display text-navy/12 text-[3rem] leading-none block mb-3">{s.n}</span>
            <h3 class="font-heading font-semibold text-navy text-[1rem] mb-3">{s.title}</h3>
            <p class="text-[0.84rem] text-navy/70 leading-[1.75]">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- Tecnologia enzimatica -->
  <section class="py-24 bg-navy">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <div class="reveal">
          <div class="section-label mb-6">Tecnologia</div>
          <h2 class="font-display uppercase text-white leading-[0.92] mb-6"
              style="font-size: clamp(2.2rem, 4.5vw, 4.5rem);">
            Sanificazione<br />a base di enzimi
          </h2>
          <p class="text-white/66 text-[1rem] leading-[1.85]">
            Gli enzimi degradano lo sporco organico e neutralizzano i batteri là dove
            si annidano i cattivi odori. Un sistema naturale ed efficace, che lavora
            senza solventi aggressivi e con acqua recuperata a fine ciclo.
          </p>
        </div>

        <div class="reveal delay-2 flex flex-col gap-0">
          {[
            'Elimina germi, batteri e larve dal fondo del bidone',
            'Rimuove i cattivi odori alla radice, non li copre',
            'Prodotti biodegradabili e sicuri per persone e animali',
            'Acqua di lavaggio recuperata e trattata a ciclo chiuso',
            'Lavaggio interno ed esterno, bidone asciutto a fine intervento',
          ].map((item, i) => (
            <div class={`flex items-center gap-4 py-4 ${i > 0 ? 'border-t border-white/14' : ''}`}>
              <div class="w-5 h-5 rounded-full border border-gold/50 flex items-center justify-center flex-shrink-0">
                <div class="w-1.5 h-1.5 rounded-full bg-gold"></div>
              </div>
              <p class="text-[0.9rem] text-white/70 leading-[1.7]">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- Isola ecologica -->
  <section class="py-24 bg-white border-b border-navy/12">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <div class="reveal delay-2 order-2 lg:order-1 flex flex-col gap-0">
          {[
            'Lavaggio ad alta pressione di pavimento, pareti e contenitori',
            'Rimozione di incrostazioni, percolato e residui organici',
            'Sanificazione completa e abbattimento dei cattivi odori',
            'Ideale per condomini, attività commerciali e aree comuni',
            'Programmabile con interventi periodici a tariffa dedicata',
          ].map((item, i) => (
            <div class={`flex items-center gap-4 py-4 ${i > 0 ? 'border-t border-navy/12' : ''}`}>
              <div class="w-5 h-5 rounded-full border border-gold/60 flex items-center justify-center flex-shrink-0">
                <div class="w-1.5 h-1.5 rounded-full bg-gold"></div>
              </div>
              <p class="text-[0.9rem] text-navy/72 leading-[1.7]">{item}</p>
            </div>
          ))}
        </div>

        <div class="reveal order-1 lg:order-2">
          <div class="section-label section-label--dark mb-6">In più</div>
          <h2 class="font-display uppercase text-navy leading-[0.92] mb-6"
              style="font-size: clamp(2.2rem, 4.5vw, 4.5rem);">
            Lavaggio<br />isola ecologica
          </h2>
          <p class="text-navy/72 text-[1rem] leading-[1.85]">
            Non solo i bidoni: laviamo e sanifichiamo l'intera piazzola di raccolta
            ad alta pressione, compresi cassonetti e contenitori condominiali.
            Rimuoviamo lo sporco che si accumula a terra e sulle pareti, eliminiamo
            gli odori e restituiamo un'area pulita e in ordine. Soluzione ideale per
            amministratori di condominio e attività: il prezzo dipende da superficie
            e stato dell'isola, perciò ti prepariamo un
            <strong class="text-navy">preventivo dedicato</strong> su richiesta.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- Prezzi -->
  <section id="prezzi" class="py-24 bg-off-white border-b border-navy/12">
    <div class="max-w-5xl mx-auto px-6 lg:px-10">
      <div class="reveal mb-14 text-center">
        <div class="section-label section-label--dark mb-5 justify-center">Tariffe trasparenti</div>
        <h2 class="font-display uppercase text-navy leading-[0.92]"
            style="font-size: clamp(2rem, 4vw, 4rem);">
          Prezzi chiari, nessuna sorpresa
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="reveal delay-1 price-card">
          <span class="block text-navy/45 text-[0.7rem] tracking-[0.22em] uppercase font-bold mb-4">Bidone 2 ruote</span>
          <p class="font-heading text-navy/70 text-[0.9rem] mb-5">Condominiale / piccolo formato</p>
          <div class="flex items-baseline gap-2">
            <span class="font-display text-navy text-[3.5rem] leading-none">15€</span>
            <span class="text-navy/55 text-[0.85rem]">+ IVA</span>
          </div>
        </div>
        <div class="reveal delay-2 price-card">
          <span class="block text-navy/45 text-[0.7rem] tracking-[0.22em] uppercase font-bold mb-4">Bidone 4 ruote</span>
          <p class="font-heading text-navy/70 text-[0.9rem] mb-5">Grande formato / condominiale</p>
          <div class="flex items-baseline gap-2">
            <span class="font-display text-navy text-[3.5rem] leading-none">25€</span>
            <span class="text-navy/55 text-[0.85rem]">+ IVA</span>
          </div>
        </div>
        <div class="reveal delay-3 price-card price-card--feature">
          <span class="block text-gold text-[0.7rem] tracking-[0.22em] uppercase font-bold mb-4">Isola ecologica</span>
          <p class="font-heading text-navy/70 text-[0.9rem] mb-5">Lavaggio ad alta pressione + sanificazione</p>
          <div class="flex items-baseline gap-2">
            <span class="text-navy/55 text-[0.8rem]">a partire da</span>
            <span class="font-display text-navy text-[3.5rem] leading-none">49€</span>
            <span class="text-navy/55 text-[0.85rem]">+ IVA</span>
          </div>
          <p class="text-navy/55 text-[0.78rem] mt-3">Prezzo finale su preventivo dedicato</p>
        </div>
      </div>

      <p class="reveal text-center text-navy/60 text-[0.9rem] leading-[1.7]">
        Per servizi periodici, condomini e attività prepariamo un
        <strong class="text-navy">preventivo dedicato</strong> con tariffe agevolate.
      </p>
    </div>
  </section>


  <!-- Dove operiamo -->
  <section class="py-24 bg-white border-b border-navy/12">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 text-center">
      <div class="reveal">
        <div class="section-label section-label--dark mb-5 justify-center">Zone servite</div>
        <h2 class="font-display uppercase text-navy leading-[0.92] mb-6"
            style="font-size: clamp(2rem, 4vw, 4rem);">
          Lavaggio bidoni a Montesilvano,<br />Pescara e zone limitrofe
        </h2>
        <p class="text-navy/72 text-[1rem] leading-[1.85] max-w-2xl mx-auto mb-10">
          Operiamo con il servizio di lavaggio e sanificazione bidoni a domicilio in
          tutta l'area metropolitana di Pescara. Raggiungiamo abitazioni, attività
          commerciali e condomini in città e nei comuni vicini.
        </p>
      </div>

      <ul class="reveal delay-1 flex flex-wrap justify-center gap-2.5" aria-label="Comuni serviti">
        {areas.map((a) => (
          <li class="area-chip">{a}</li>
        ))}
      </ul>

      <p class="reveal delay-2 text-navy/55 text-[0.88rem] mt-8">
        Il tuo comune non è in elenco?
        <a href="#prenota" class="text-gold font-semibold hover:underline">Scrivici lo stesso</a>:
        valutiamo ogni richiesta nella zona di Pescara e Chieti.
      </p>
    </div>
  </section>


  <!-- Form prenotazione -->
  <section id="prenota" class="relative overflow-hidden bg-navy pt-24 pb-28">
    <div class="hero-grid absolute inset-0 pointer-events-none"></div>
    <div class="absolute inset-0 pointer-events-none"
         style="background: radial-gradient(ellipse 60% 70% at 80% 20%, rgba(199,162,74,0.1) 0%, transparent 50%);"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-12 lg:gap-20 items-start">

        <!-- Left: info -->
        <div class="reveal lg:sticky lg:top-28">
          <div class="section-label mb-7">Richiedi disponibilità</div>
          <h2 class="font-display uppercase text-white leading-[0.9] mb-7"
              style="font-size: clamp(2.4rem, 5vw, 4.5rem);">
            Richiedi<br />disponibilità
          </h2>
          <p class="text-[1rem] text-white/74 leading-[1.75] max-w-xl mb-10">
            Indica quanti bidoni vuoi far lavare e dove. Ti ricontattiamo per valutare
            la richiesta e inserirti nel calendario di partenza del servizio.
          </p>

          <div class="space-y-0 border border-white/14">
            {[
              { n: '01', title: 'Compili il form', sub: 'Bastano numero di bidoni e indirizzo.' },
              { n: '02', title: 'Ti ricontattiamo', sub: 'Valutiamo la richiesta e le zone di partenza.' },
              { n: '03', title: 'Entri in calendario', sub: 'Ti inseriamo tra i primi interventi in programma.' },
            ].map((s, i) => (
              <div class={`flex items-start gap-4 p-5 ${i > 0 ? 'border-t border-white/14' : ''} bg-white/[0.07]`}>
                <span class="font-display text-gold/85 text-[0.7rem] tracking-[0.3em] flex-shrink-0 mt-0.5">{s.n}</span>
                <div>
                  <strong class="block text-white font-heading font-semibold text-[0.95rem] mb-0.5">{s.title}</strong>
                  <p class="text-white/62 text-[0.8rem]">{s.sub}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: form -->
        <div class="reveal delay-2">
          <form id="booking-form" class="analysis-form" novalidate>
            <div class="mb-7">
              <p class="text-gold/85 text-[0.62rem] tracking-[0.24em] uppercase font-bold mb-2">Richiesta di sopralluogo / disponibilità</p>
              <h3 class="font-display uppercase text-white leading-[0.92]"
                  style="font-size: clamp(1.7rem, 3.5vw, 2.6rem);">
                I tuoi bidoni, igienizzati.
              </h3>
            </div>

            <!-- Honeypot anti-spam -->
            <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
              <label>Sito web (lascia vuoto)
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div class="form-row">
              <label>
                <span>Bidoni 2 ruote (15€)</span>
                <input type="number" name="bidoni2" min="0" max="50" value="1" />
              </label>
              <label>
                <span>Bidoni 4 ruote (25€)</span>
                <input type="number" name="bidoni4" min="0" max="50" value="0" />
              </label>
            </div>

            <!-- Isola ecologica -->
            <label class="isola-toggle">
              <input type="checkbox" name="isola" value="si" />
              <span class="isola-toggle-box">
                <strong>Aggiungi lavaggio isola ecologica</strong>
                <em>Su preventivo dedicato — a partire da 49€ + IVA</em>
              </span>
            </label>

            <div class="form-row">
              <label>
                <span>Nome e cognome</span>
                <input type="text" name="nome" placeholder="Nome e cognome" required />
              </label>
              <label>
                <span>Telefono</span>
                <input type="tel" name="telefono" placeholder="+39" required />
              </label>
            </div>

            <label>
              <span>Email</span>
              <input type="email" name="email" placeholder="nome@dominio.it" required />
            </label>

            <label>
              <span>Indirizzo del lavaggio</span>
              <input type="text" name="indirizzo" placeholder="Via, numero civico, città" required />
            </label>

            <div class="form-row">
              <label>
                <span>Data preferita (facoltativa)</span>
                <input type="date" name="data" />
              </label>
              <label>
                <span>Note (facoltative)</span>
                <input type="text" name="note" placeholder="Es: bidone sul retro" />
              </label>
            </div>

            <button type="submit">Richiedi sopralluogo / informazioni →</button>

            <p id="booking-feedback" class="form-feedback mt-4" role="status" aria-live="polite"></p>

            <p class="form-note mt-4">
              Ti ricontattiamo per valutare la richiesta e inserirti nel calendario di partenza — <strong>info@arsolving.it</strong>
            </p>
          </form>
        </div>

      </div>
    </div>
  </section>


  <!-- FAQ -->
  <section class="py-24 bg-off-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-10">
      <div class="reveal mb-12 text-center">
        <div class="section-label section-label--dark mb-5 justify-center">Domande frequenti</div>
        <h2 class="font-display uppercase text-navy leading-[0.92]"
            style="font-size: clamp(2rem, 4vw, 4rem);">
          Le domande più comuni
        </h2>
      </div>

      <div class="flex flex-col">
        {faqs.map((f, i) => (
          <details class={`faq-item reveal delay-${(i % 3) + 1}`}>
            <summary>
              <span>{f.q}</span>
              <svg class="faq-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">

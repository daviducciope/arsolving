---
import Base from '../layouts/Base.astro'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<Base title="Projects & Ventures"
      description="ARSOLVING Projects — sviluppo di iniziative, partnership strategiche, nuovi progetti da zero.">

  <!-- Hero -->
  <div class="page-hero">
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <div class="section-label mb-6">Arsolving</div>
      <h1 class="font-display uppercase text-white leading-[0.9] mb-5"
          style="font-size: clamp(3rem, 7vw, 6.5rem);">
        Area Strategica
      </h1>
      <p class="text-[1rem] text-white/66 leading-[1.8] max-w-xl">
        Partnership, sviluppo iniziative, consulenza e nuovi progetti costruiti da zero.
        Dalla visione alla realtà operativa.
      </p>
    </div>
  </div>


  <!-- Posizione -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-start">

        <div class="reveal">
          <div class="label-chip mb-6">La posizione</div>
          <h2 class="font-display uppercase text-navy leading-[0.92] mb-8"
              style="font-size: clamp(2.2rem, 4.5vw, 4.5rem);">
            Costruiamo<br />da zero.
          </h2>
          <div class="space-y-5 text-[1rem] text-navy/72 leading-[1.85]">
            <p>
              Abbiamo aperto un temporary store in dicembre: trovato il locale,
              allestito, ingaggiati i fornitori, creato il logo e il brand digitale.
              Da idea a operativo in poche settimane — senza chiedere a nessuno come fare.
            </p>
            <p>
              Questa è l'area strategica di ARSOLVING: sviluppiamo iniziative concrete,
              in collaborazione con partner selezionati o autonomamente, attorno a
              opportunità identificate con metodo.
            </p>
            <p>
              Il criterio di selezione è sempre lo stesso: fattibilità reale,
              impatto misurabile, sinergia con le competenze operative e digitali del gruppo.
            </p>
          </div>
        </div>

        <div class="reveal delay-2">
          <div class="bg-off-white border border-navy/14 p-10 mb-4">
            <div class="font-heading italic text-gold text-[1rem] mb-6 leading-relaxed">
              "Non ogni idea diventa un progetto.<br />
              Ma ogni progetto inizia da un'idea<br />
              analizzata con serietà e costruita con metodo."
            </div>
            <div class="space-y-4">
              {[
                { label: 'Analisi preventiva',  val: 'Ogni iniziativa è valutata su fattibilità, mercato e risorse disponibili prima di muoversi.' },
                { label: 'Sviluppo graduale',   val: 'Procediamo per fasi validate. Nessun "big bang": prima si funziona, poi si scala.' },
                { label: 'Partnership mirate',  val: 'Collaboriamo con partner selezionati su obiettivi e valori condivisi.' },
              ].map((item, i) => (
                <div class={`flex items-start gap-4 pt-4 ${i > 0 ? 'border-t border-navy/14' : ''}`}>
                  <div class="w-1.5 h-1.5 rounded-full bg-gold mt-2 flex-shrink-0"></div>
                  <div>
                    <div class="text-[0.8rem] font-semibold text-navy mb-1">{item.label}</div>
                    <div class="text-[0.82rem] text-navy/66 leading-[1.65]">{item.val}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- Aree di sviluppo -->
  <section class="py-24 bg-off-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="reveal mb-12">
        <div class="label-chip mb-5">Dove operiamo</div>
        <h2 class="font-display uppercase text-navy leading-[0.92]"
            style="font-size: clamp(2rem, 4.5vw, 4.5rem);">
          Aree di sviluppo
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {[
          {
            title: 'Nuovi servizi operativi',
            desc: 'Estensione dell\'area operativa con nuove tipologie di servizio sul territorio: facility avanzato, presidio di strutture complesse, nuove partnership con fornitori specializzati.',
          },
          {
            title: 'Piattaforme e strumenti digitali',
            desc: 'Sviluppo di prodotti digitali verticali su segmenti identificati. Dashboard gestionali, piattaforme b2b, strumenti operativi custom.',
          },
          {
            title: 'Partnership strategiche',
            desc: 'Collaborazioni strutturate con aziende e professionisti che condividono la visione di crescita sistematica e orientata alla qualità operativa.',
          },
          {
            title: 'Progetti da zero',
            desc: 'Temporary store, nuovi concept, iniziative locali. Se c\'è un\'opportunità concreta, ARSOLVING è in grado di costruire l\'intera struttura operativa intorno ad essa.',
          },
        ].map((item, i) => (
          <div class={`reveal delay-${(i % 2) + 1} bg-white border border-navy/14 p-8 hover:-translate-y-0.5 hover:shadow-lg transition-all duration-300 relative`}>
            <div class="absolute top-0 left-0 bottom-0 w-[2px]"
                 style="background: linear-gradient(180deg, #0E1D34, #C7A24A);"></div>
            <h3 class="font-heading font-semibold text-navy text-[1rem] mb-3 pl-4">{item.title}</h3>
            <p class="text-[0.86rem] text-navy/78 leading-[1.75] pl-4">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- CTA -->
  <section class="py-24 bg-navy">
    <div class="max-w-3xl mx-auto px-6 text-center reveal">
      <div class="section-label justify-center mb-6">Partnership</div>
      <h2 class="font-display uppercase text-white leading-[0.92] mb-5"
          style="font-size: clamp(2.2rem, 5vw, 5rem);">
        Hai un'idea<br />o una proposta?
      </h2>
      <p class="text-white/66 text-[1rem] leading-[1.8] mb-10">
        Valutiamo ogni proposta con attenzione. Se hai un progetto concreto
        o una visione da sviluppare insieme, parliamoci senza impegno.
      </p>
      <a href={`${base}/contatti/`} class="btn-gold">Proponi una collaborazione</a>
    </div>
  </section>

</Base>

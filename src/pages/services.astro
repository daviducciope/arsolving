---
import Base from '../layouts/Base.astro'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const services = [
  {
    n: '01',
    title: 'Pulizie Professionali',
    desc: 'Uffici, spazi commerciali, residenze, vetrate con elevatore mobile. Protocolli documentati, materiali certificati, personale qualificato. Interventi programmati o urgenti.',
    icon: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
  },
  {
    n: '02',
    title: 'Allestimenti & Eventi',
    desc: 'Food & beverage, spazi temporanei, stand, temporary store. Dalla logistica al montaggio, anche last-minute. Abbiamo allestito eventi sportivi, fiere e pop-up in tempi record.',
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  },
  {
    n: '03',
    title: 'Forniture Urgenti',
    desc: 'Tabelle stradali, segnaletica, attrezzature, arredi, consumabili. Reperiamo quello che serve quando non riesci a trovarlo. Consegna in 24h dove possibile.',
    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  },
  {
    n: '04',
    title: 'Manutenzione Edifici',
    desc: 'Interventi di manutenzione per edifici e spazi condominiali: idraulica, elettricità di base, riparazioni, ripristini. Tempistica rapida, ogni intervento tracciato.',
    icon: 'M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z',
  },
  {
    n: '05',
    title: 'Gestione Aree Verdi',
    desc: 'Manutenzione programmata di aree verdi private e condominiali. Taglio, potatura, trattamenti stagionali. Pianificazione annuale su richiesta.',
    icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064',
  },
  {
    n: '06',
    title: 'Facility Management',
    desc: 'Supervisione e coordinamento di tutti i servizi operativi per strutture complesse. Un referente unico gestisce fornitori, programmazione e reportistica.',
    icon: 'M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2',
  },
]
---

<Base title="Arsolving Operativa"
      description="Arsolving Operativa — pulizie, allestimenti, forniture urgenti, manutenzione, facility management. Sul campo in ore.">

  <!-- Hero -->
  <div class="page-hero">
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <h1 class="font-display uppercase text-white leading-[0.9] mb-5"
          style="font-size: clamp(3rem, 7vw, 6.5rem);">
        Area Operativa
      </h1>
      <p class="text-[1rem] text-white/66 leading-[1.8] max-w-xl">
        Pulizie, allestimenti, forniture urgenti, manutenzione, facility.
        Sul campo in ore — non in settimane.
      </p>
    </div>
  </div>


  <!-- Intro -->
  <section class="py-20 bg-white border-b border-navy/12">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <h2 class="font-display uppercase text-navy leading-[0.92]"
              style="font-size: clamp(2.2rem, 4.5vw, 4.5rem);">
            Il problema arriva.<br />Noi siamo già lì.
          </h2>
        </div>
        <div class="reveal delay-2">
          <p class="text-[1rem] text-navy/72 leading-[1.85] mb-5">
            Abbiamo pulito finestre fino al terzo piano con elevatore mobile e risolto
            un'infestazione di piccioni per il Comune di Montesilvano — lo stesso giorno.
            Abbiamo allestito food & beverage per un torneo sportivo rimasto senza fornitori.
          </p>
          <p class="text-[1rem] text-navy/72 leading-[1.85]">
            Qualsiasi problema operativo ha una soluzione. Non lavoriamo con
            protocolli rigidi che rallentano: leggiamo il contesto, ci muoviamo in fretta,
            documentiamo tutto.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- Servizi -->
  <section class="py-24 bg-off-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="reveal mb-12 text-center">
        <h2 class="font-display uppercase text-navy leading-[0.92]"
            style="font-size: clamp(2rem, 4vw, 4rem);">
          Cosa gestiamo
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {services.map((s, i) => (
          <div class={`reveal delay-${(i % 3) + 1} service-card group`}>
            <div class="flex items-start justify-between mb-5">
              <div class="w-11 h-11 bg-navy rounded-sm flex items-center justify-center text-gold
                          group-hover:bg-gold group-hover:text-navy transition-colors duration-300">
                <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={s.icon}/>
                </svg>
              </div>
              <span class="font-display text-navy/10 text-[2.5rem] leading-none">{s.n}</span>
            </div>
            <h3 class="font-heading font-semibold text-navy text-[1rem] mb-3">{s.title}</h3>
            <p class="text-[0.84rem] text-navy/70 leading-[1.78]">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- Il vantaggio -->
  <section class="py-24 bg-navy">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">

        <div class="reveal">
          <h2 class="font-display uppercase text-white leading-[0.92] mb-6"
              style="font-size: clamp(2.2rem, 4.5vw, 4.5rem);">
            Un referente.<br />Zero frammentazione.
          </h2>
          <p class="text-white/66 text-[1rem] leading-[1.85]">
            Gestire edifici e strutture significa coordinare più variabili in contemporanea.
            Con ARSOLVING hai un unico interlocutore che supervisiona tutto, traccia ogni
            intervento e risponde direttamente.
          </p>
        </div>

        <div class="reveal delay-2 flex flex-col gap-0">
          {[
            'Interventi anche urgenti e last-minute',
            'Referente dedicato per ogni cliente',
            'Ogni intervento tracciato con tempi definiti',
            'Rete di fornitori specializzati già attiva',
            'Standard qualitativi uniformi su tutti i fronti',
          ].map((item, i) => (
            <div class={`flex items-center gap-4 py-4 ${i > 0 ? 'border-t border-white/14' : ''}`}>
              <div class="w-5 h-5 rounded-full border border-gold/50 flex items-center justify-center flex-shrink-0">
                <div class="w-1.5 h-1.5 rounded-full bg-gold"></div>
              </div>
              <p class="text-[0.9rem] text-white/70 leading-[1.7]">{item}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>


  <!-- CTA -->
  <section class="py-20 bg-white border-t border-navy/12">
    <div class="max-w-3xl mx-auto px-6 text-center reveal">
      <h2 class="font-display uppercase text-navy leading-[0.92] mb-5"
          style="font-size: clamp(2rem, 4vw, 4rem);">
        Hai un problema operativo?
      </h2>
      <p class="text-navy/78 text-[1rem] leading-[1.8] mb-10">
        Descrivici la situazione. In 30 minuti capiamo cosa serve e ci muoviamo.
      </p>
      <a href={`${base}/contatti/`} class="btn-gold">Raccontaci il problema</a>
    </div>
  </section>

</Base>

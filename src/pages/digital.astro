---
import Base from '../layouts/Base.astro'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const services = [
  {
    n: '01',
    title: 'Branding & Identità',
    desc: 'Costruzione e sviluppo dell\'identità visiva. Logo system, palette, tipografia, brand guidelines. Un\'identità solida riduce il lavoro di comunicazione a lungo termine.',
    icon: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
  },
  {
    n: '02',
    title: 'Comunicazione Strategica',
    desc: 'Definizione del tono di voce, messaggi chiave e architettura dei contenuti. Costruiamo il sistema comunicativo prima di produrre qualsiasi contenuto.',
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
  },
  {
    n: '03',
    title: 'Graphic Design',
    desc: 'Produzione di materiali visivi per ogni contesto: print, digital, presentazioni, formati editoriali. Design funzionale prima che decorativo.',
    icon: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z',
  },
  {
    n: '04',
    title: 'Web & Siti',
    desc: 'Progettazione e sviluppo di siti web corporate, landing page e portali. Architettura orientata agli obiettivi, performance e accessibilità.',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  },
  {
    n: '05',
    title: 'Applicazioni Web',
    desc: 'Sviluppo di web application e strumenti digitali ad hoc. Dalla gestione interna ai portali cliente, con architetture moderne e codice manutenibile.',
    icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
  {
    n: '06',
    title: 'Marketing Digitale',
    desc: 'Pianificazione e gestione di campagne online. SEO, advertising e analytics strutturati su obiettivi di business misurabili, non su metriche vanity.',
    icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
  },
]
---

<Base title="Arsolving Digital"
      description="Arsolving Digital — comunicazione, branding, web, app e marketing digitale per aziende e progetti.">

  <!-- Hero -->
  <div class="page-hero">
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <div class="flex items-center gap-3 text-gold text-[0.68rem] tracking-[0.24em] uppercase mb-6">
        <span class="block w-7 h-px bg-gold"></span>Arsolving
      </div>
      <h1 class="font-heading font-semibold text-white leading-[1.1] mb-5"
          style="font-size: clamp(2.5rem, 5vw, 4rem);">
        Digital
      </h1>
      <p class="text-[1.05rem] text-white/48 leading-[1.8] max-w-xl">
        Comunicazione, branding, sviluppo e marketing digitale.
        Una regia strategica unica per la tua presenza online e la tua identità di marca.
      </p>
    </div>
  </div>


  <!-- Intro -->
  <section class="py-20 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <div class="flex items-center gap-3 text-gold text-[0.68rem] tracking-[0.24em] uppercase mb-6">
            <span class="block w-7 h-px bg-gold"></span>L'approccio digitale
          </div>
          <h2 class="font-heading font-semibold text-navy leading-[1.15]"
              style="font-size: clamp(1.8rem, 3vw, 2.4rem);">
            Strategia prima.<br />Esecuzione dopo.
          </h2>
        </div>
        <div class="reveal delay-2">
          <p class="text-[1rem] text-gray-500 leading-[1.85] mb-5">
            Arsolving Digital raccoglie tutte le competenze di comunicazione, design e sviluppo
            tecnologico del gruppo. Non lavoriamo a compartimenti stagni: brand, contenuti,
            web e marketing vengono progettati come un sistema unico e coerente.
          </p>
          <p class="text-[1rem] text-gray-500 leading-[1.85]">
            Il risultato è una presenza digitale che funziona davvero, non una collezione
            di asset scoordinati. Dal logo al sito, dalla campagna alla piattaforma.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- Services grid -->
  <section class="py-28 bg-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="reveal mb-14 text-center">
        <div class="flex items-center justify-center gap-3 text-gold text-[0.68rem] tracking-[0.24em] uppercase mb-5">
          <span class="block w-7 h-px bg-gold"></span>I servizi<span class="block w-7 h-px bg-gold"></span>
        </div>
        <h2 class="font-heading font-semibold text-navy leading-[1.15]"
            style="font-size: clamp(1.8rem, 3vw, 2.6rem);">
          Aree di competenza
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {services.map((s, i) => (
          <div class={`reveal delay-${(i % 3) + 1} group bg-white border border-gray-100 rounded-lg p-8
                       relative overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300`}>
            <div class="absolute top-0 left-0 right-0 h-[2px] scale-x-0 group-hover:scale-x-100
                        transition-transform duration-400 origin-left"
                 style="background: linear-gradient(90deg, #B5973A, #1D2D50);"></div>
            <div class="font-heading text-[2.8rem] font-bold text-gray-100 leading-none mb-4">{s.n}</div>
            <div class="w-10 h-10 bg-navy rounded flex items-center justify-center text-gold mb-5
                        group-hover:bg-gold group-hover:text-navy-dark transition-colors duration-300">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={s.icon}/>
              </svg>
            </div>
            <h3 class="text-[1rem] font-semibold text-navy mb-3">{s.title}</h3>
            <p class="text-[0.87rem] text-gray-500 leading-[1.78]">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- Come lavoriamo -->
  <section class="py-24 bg-navy-dark relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none"
         style="background: radial-gradient(ellipse 60% 60% at 80% 50%, rgba(181,151,58,0.05) 0%, transparent 60%);"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <div class="reveal text-center max-w-xl mx-auto mb-14">
        <div class="flex items-center justify-center gap-3 text-gold text-[0.68rem] tracking-[0.24em] uppercase mb-5">
          <span class="block w-7 h-px bg-gold"></span>Come lavoriamo<span class="block w-7 h-px bg-gold"></span>
        </div>
        <h2 class="font-heading font-semibold text-white leading-[1.15]"
            style="font-size: clamp(1.8rem, 3vw, 2.4rem);">
          Dalla strategia al pixel.
        </h2>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { n: '01', title: 'Brief',      text: 'Ascoltiamo, analizziamo il contesto e gli obiettivi di business prima di qualsiasi proposta.' },
          { n: '02', title: 'Strategia',  text: 'Progettiamo la soluzione con una logica documentata. Niente estetismo fine a sé stesso.' },
          { n: '03', title: 'Delivery',   text: 'Eseguiamo con precisione, rispettando feedback, milestone e budget concordati.' },
          { n: '04', title: 'Misurazione',text: 'Misuriamo l\'impatto delle scelte con KPI reali. Il lavoro non finisce alla consegna.' },
        ].map((step, i) => (
          <div class={`reveal delay-${i+1} text-center group`}>
            <div class="w-12 h-12 rounded-full border border-gold/35 flex items-center justify-center
                        mx-auto mb-5 group-hover:bg-gold group-hover:border-gold transition-all duration-300">
              <span class="font-heading text-[0.82rem] text-gold group-hover:text-navy-dark
                           transition-colors duration-300 font-semibold">{step.n}</span>
            </div>
            <h4 class="text-[0.9rem] font-semibold text-white mb-2">{step.title}</h4>
            <p class="text-[0.8rem] text-white/38 leading-[1.65]">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- CTA -->
  <section class="py-20 bg-white border-t border-gray-100">
    <div class="max-w-3xl mx-auto px-6 text-center reveal">
      <h2 class="font-heading font-semibold text-navy leading-[1.2] mb-5"
          style="font-size: clamp(1.8rem, 3vw, 2.4rem);">
        Hai un progetto digitale?
      </h2>
      <p class="text-[1rem] text-gray-400 leading-[1.8] mb-10">
        Che si tratti di un rebranding, un sito nuovo o una campagna strutturata,
        iniziamo dalla strategia.
      </p>
      <a href={`${base}/contatti/`}
         class="inline-block px-10 py-4 bg-gold text-navy-dark text-[0.8rem] font-semibold
                tracking-[0.16em] uppercase rounded hover:bg-gold-light
                transition-all duration-200 hover:-translate-y-0.5">
        Parliamone
      </a>
    </div>
  </section>

</Base>

---
import Base from '../layouts/Base.astro'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const services = [
  {
    n: '01',
    title: 'Siti Web & Landing Page',
    desc: 'Progettazione e sviluppo da zero, anche in tempi record. Abbiamo consegnato un sito completo per un ristorante in 48 ore. Architettura orientata agli obiettivi, performance e mobile-first.',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  },
  {
    n: '02',
    title: 'Brand Identity & Logo',
    desc: 'Costruzione dell\'identità visiva da zero: logo, palette, tipografia, brand guidelines. Abbiamo creato brand completi per temporary store, locali e progetti digitali.',
    icon: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
  },
  {
    n: '03',
    title: 'Graphic Design',
    desc: 'Materiali visivi per ogni contesto: segnaletica, print, digital, presentazioni. Abbiamo progettato il contenuto grafico per tabelle stradali in 24h. Design funzionale, non decorativo.',
    icon: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z',
  },
  {
    n: '04',
    title: 'Comunicazione Strategica',
    desc: 'Tono di voce, messaggi chiave, architettura dei contenuti. Costruiamo il sistema comunicativo prima di produrre qualsiasi contenuto. Nessuna campagna senza strategia.',
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
  },
  {
    n: '05',
    title: 'Applicazioni Web',
    desc: 'Web app e strumenti digitali custom. Dashboard gestionali, portali cliente, sistemi interni. Architetture moderne, codice pulito e manutenibile.',
    icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
  {
    n: '06',
    title: 'Marketing Digitale',
    desc: 'SEO, advertising, social media, analytics. Campagne strutturate su obiettivi di business misurabili, non su metriche vanity. Misuriamo ogni lira investita.',
    icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
  },
]

const staFeatures = [
  {
    n: '01',
    label: 'Identità',
    title: 'Brand sistematici',
    desc: 'Logo, palette, tipografia, materiale coordinato. Sistemi visivi coerenti,costruiti per adattarsi a ogni contesto.',
  },
  {
    n: '02',
    label: 'Web',
    title: 'Siti che convertono',
    desc: 'Architettura orientata agli obiettivi, performance reale, mobile-first. Online in giorni.',
  },
  {
    n: '03',
    label: 'Crescita',
    title: 'Adv & social misurabili',
    desc: 'Google Ads, Meta, social strategy. Budget chiari, KPI di business, report trasparenti.',
  },
]

const portfolio = [
  {
    title: 'AgriPlanet Store',
    tags: ['E-commerce', 'Web Design', 'Brand Identity'],
    desc: "E-commerce per fitofarmaci, concimi, sementi e macchine agricole. Identità e piattaforma di vendita costruite da zero.",
    url: 'https://agriplanetstore.it',
    img: 'https://stacomunicazionedesign.it/assets/img/agriplanetstore.png',
  },
  {
    title: 'Sostanza Servizi',
    tags: ['Web Platform', 'Brand Strategy', 'UX Design'],
    desc: 'Piattaforma web per gruppo multicomparto: raccolta rifiuti, pulizie e ristrutturazioni. Brand e architettura della comunicazione.',
    url: 'https://sostanzaservizi.it',
    img: 'https://stacomunicazionedesign.it/assets/img/sostanza-multiservizi.png',
  },
  {
    title: 'Hurka',
    tags: ['Rebranding', 'Website', 'UX/UI'],
    desc: 'Rebranding completo e nuovo sito per consulenza energetica specializzata in fotovoltaico. Posizionamento premium.',
    url: 'https://hurka.it',
    img: 'https://stacomunicazionedesign.it/assets/img/hurka_mobile.png',
  },
  {
    title: 'De Marco Studio Legale',
    tags: ['Corporate Website', 'UX', 'Copywriting'],
    desc: 'Sito corporate per studio legale penalista e civilista a Pescara. Copywriting strategico e architettura orientata alla credibilità.',
    url: 'https://demarcostudiolegale.it',
    img: 'https://stacomunicazionedesign.it/assets/img/demarcostudiolegale_mobile.png',
  },
  {
    title: 'Vignaluna',
    tags: ['Restaurant Website', 'Food Experience', 'UX/UI'],
    desc: 'Sito per pizzeria a legna ed enoteca a Santa Marinella. Esperienza digitale attorno all\'identità del locale: territorio, gusto, atmosfera.',
    url: 'https://ristorantevignaluna.it',
    img: null,
  },
  {
    title: 'Girofacile',
    tags: ['Web App', 'UI/UX', 'Logistica'],
    desc: 'Dashboard per la gestione delle consegne e la logistica dell\'ultimo miglio. Interfaccia operativa progettata per semplicità e velocità.',
    url: null,
    img: null,
  },
]
---

<Base title="Arsolving Digital"
      description="Arsolving Digital — siti web, brand identity, grafica, comunicazione strategica e marketing digitale. Online in giorni.">

  <!-- Hero -->
  <div class="page-hero">
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <h1 class="font-display uppercase text-white leading-[0.9] mb-5"
          style="font-size: clamp(3rem, 7vw, 6.5rem);">
        Area Digitale
      </h1>
      <p class="text-[1rem] text-white/66 leading-[1.8] max-w-2xl">
        Per ogni progetto digitale ARSOLVING opera con
        <span class="text-gold font-semibold">stà comunicazione &amp; design</span>, la
        divisione specializzata in identità visiva, web e advertising.
        Dalla strategia all'online, in giorni.
      </p>
    </div>
  </div>


  <!-- Si chiama stà -->
  <section class="py-24 bg-white border-b border-navy/12">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">

        <div class="reveal lg:col-span-7">
          <h2 class="font-display uppercase text-navy leading-[0.92] mb-7"
              style="font-size: clamp(2.4rem, 5vw, 5rem);">
            Si chiama <span class="text-gold">stà.</span><br />
            <span class="text-navy/55" style="font-size: 0.6em;">comunicazione &amp; design</span>
          </h2>
          <div class="space-y-5 text-[1rem] text-navy/72 leading-[1.85]">
            <p>
              Dietro ogni sito, brand identity o campagna firmata ARSOLVING c'è
              <strong class="text-navy font-semibold">stà comunicazione &amp; design</strong>:
              agenzia di comunicazione e design con base a
              <span class="text-navy font-medium">Montesilvano (PE)</span>, parte integrante
              del gruppo, dedicata interamente al digitale.
            </p>
            <p>
              È stà che progetta i sistemi visivi, sviluppa i siti, costruisce le campagne adv.
              ARSOLVING porta il metodo, la velocità e la regia di progetto: stà porta
              competenza specialistica, sensibilità estetica e cura della delivery.
            </p>
            <p class="font-heading italic text-navy/68 text-[0.95rem]">
              "Diamo forma alla tua sostanza.", il payoff con cui stà racconta il proprio modo di lavorare.
            </p>
          </div>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a href="https://stacomunicazionedesign.it" target="_blank" rel="noopener noreferrer"
               class="btn-gold">
              Visita stacomunicazionedesign.it
              <svg class="w-3 h-3 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 4h6m0 0v6m0-6L10 14M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4"/>
              </svg>
            </a>
            <a href={`${base}/contatti/`} class="btn-outline-navy">Brief con ARSOLVING</a>
          </div>
        </div>

        <div class="reveal delay-2 lg:col-span-5">
          <div class="sta-card">
            <div class="sta-card-frame">
              <span class="sta-card-eyebrow">Sub-brand di ARSOLVING</span>
              <div class="sta-wordmark font-display">
                <span class="sta-wordmark-main">stà.</span>
                <span class="sta-wordmark-sub">comunicazione &amp; design</span>
              </div>
              <div class="sta-divider"></div>
              <dl class="sta-meta">
                <div>
                  <dt>Sede</dt><dd>Montesilvano · Pescara</dd>
                </div>
                <div>
                  <dt>Focus</dt><dd>Brand · Web · Adv · Social</dd>
                </div>
                <div>
                  <dt>Mercato</dt><dd>Abruzzo &amp; clienti in tutta Italia</dd>
                </div>
              </dl>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- Cosa porta in dote stà -->
  <section class="py-24 bg-navy-mid">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">

      <div class="reveal mb-12 lg:mb-16">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
          <h2 class="font-display uppercase text-white leading-[0.92]"
              style="font-size: clamp(2.4rem, 5vw, 5rem);">
            Tre cose,<br />fatte bene.
          </h2>
          <p class="text-white/66 text-[0.9rem] leading-[1.7] max-w-[38ch] lg:text-right">
            Non un'agenzia generalista. Una struttura focalizzata su tre fronti
            che si tengono per mano: identità, web, crescita.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-3">
        {staFeatures.map((f, i) => (
          <div class={`reveal delay-${i + 1} area-panel`}>
            <div class="flex items-start justify-between mb-6">
              <span class="text-gold/85 font-display text-[0.75rem] tracking-[0.3em]">{f.n}</span>
              <span class="text-white/45 text-[0.58rem] tracking-[0.22em] uppercase font-bold">{f.label}</span>
            </div>
            <h3 class="font-display uppercase text-white text-[1.6rem] leading-[1.05] mb-3">
              {f.title}
            </h3>
            <p class="text-white/66 text-[0.86rem] leading-[1.75]">{f.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- Servizi -->
  <section class="py-24 bg-off-white">
    <div class="max-w-7xl mx-auto pl-6 lg:pl-10">
      <div class="reveal mb-10 pr-6 lg:pr-10">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
          <h2 class="font-display uppercase text-navy leading-[0.92]"
              style="font-size: clamp(2rem, 4vw, 4rem);">
            Cosa fa stà,<br />nel concreto.
          </h2>
          <p class="text-navy/66 text-[0.88rem] leading-[1.7] max-w-[36ch] lg:text-right">
            Sei aree operative. Una sola squadra che le coordina,
            con metodo e tempi certi.
          </p>
        </div>
        <div class="h-carousel-hint mt-6">
          <span>Scorri</span>
          <svg class="w-8 h-2" viewBox="0 0 32 8" fill="none" stroke="currentColor" stroke-width="1.4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M0 4h28m-4-4l4 4-4 4"/>
          </svg>
        </div>
      </div>

      <div class="h-carousel">
        {services.map((s) => (
          <div class="h-carousel-item service-card group">
            <div class="flex items-start justify-between mb-5">
              <div class="w-11 h-11 bg-navy rounded-sm flex items-center justify-center text-gold
                          group-hover:bg-gold group-hover:text-navy transition-colors duration-300">
                <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={s.icon}/>
                </svg>
              </div>
              <span class="font-display text-navy/10 text-[2.5rem] leading-none">{s.n}</span>
            </div>
            <h3 class="font-heading font-semibold text-navy text-[1rem] mb-3">{s.title}</h3>
            <p class="text-[0.84rem] text-navy/70 leading-[1.78]">{s.desc}</p>
          </div>
        ))}
        <div class="h-carousel-spacer" aria-hidden="true"></div>
      </div>
    </div>
  </section>


  <!-- Portfolio -->
  <section class="py-24 bg-white border-t border-navy/12">
    <div class="max-w-7xl mx-auto pl-6 lg:pl-10">
      <div class="reveal mb-10 pr-6 lg:pr-10">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
          <h2 class="font-display uppercase text-navy leading-[0.92]"
              style="font-size: clamp(2rem, 4vw, 4rem);">
            Lavori selezionati
          </h2>
          <p class="text-navy/66 text-[0.88rem] leading-[1.7] max-w-[34ch] lg:text-right">
            Una selezione di progetti realizzati da stà per clienti
            in settori molto diversi tra loro.
          </p>
        </div>
        <div class="h-carousel-hint mt-6">
          <span>Scorri</span>
          <svg class="w-8 h-2" viewBox="0 0 32 8" fill="none" stroke="currentColor" stroke-width="1.4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M0 4h28m-4-4l4 4-4 4"/>
          </svg>
        </div>
      </div>

      <div class="h-carousel">
        {portfolio.map((p) => (
          <div class="h-carousel-item group flex flex-col bg-white border border-navy/14 rounded-sm overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
            <div class="relative overflow-hidden bg-cream h-48 flex-shrink-0">
              {p.img ? (
                <img src={p.img} alt={p.title}
                     class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-500" />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <span class="text-navy/20 font-display text-[0.7rem] tracking-[0.2em] uppercase">Preview in arrivo</span>
                </div>
              )}
            </div>
            <div class="p-5 flex flex-col flex-1">
              <div class="flex flex-wrap gap-1.5 mb-3">
                {p.tags.map(tag => (
                  <span class="text-[0.58rem] tracking-[0.14em] uppercase font-bold text-gold border border-gold/45 px-2 py-0.5 rounded-sm">
                    {tag}
                  </span>
                ))}
              </div>
              <h3 class="font-heading font-semibold text-navy text-[1.05rem] mb-2">{p.title}</h3>
              <p class="text-[0.82rem] text-navy/78 leading-[1.7] flex-1">{p.desc}</p>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-2 mt-4 text-[0.7rem] tracking-[0.14em] uppercase font-bold text-navy/62 hover:text-gold transition-colors duration-200">
                  Visita il sito
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
              )}
            </div>
          </div>
        ))}
        <div class="h-carousel-spacer" aria-hidden="true"></div>
      </div>
    </div>
  </section>


  <!-- Come lavoriamo: ARSOLVING + stà -->
  <section class="py-24 bg-navy">
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <div class="reveal mb-12">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
          <h2 class="font-display uppercase text-white leading-[0.92]"
              style="font-size: clamp(2rem, 4vw, 4rem);">
            ARSOLVING porta il problema.<br />stà lo trasforma in design.
          </h2>
          <p class="text-white/60 text-[0.88rem] leading-[1.7] max-w-[36ch] lg:text-right">
            Una sola squadra, due competenze. Tu parli con un solo interlocutore;
            in cabina di regia ci muoviamo insieme.
          </p>
        </div>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          { n: '01', tag: 'ARSOLVING', title: 'Brief',     text: 'Leggiamo il problema digitale nel contesto reale: business, tempi, budget.' },
          { n: '02', tag: 'stà',       title: 'Strategia', text: 'Tradotto in soluzione progettuale: identità, web, campagne. Logica documentata.' },
          { n: '03', tag: 'stà',       title: 'Delivery',  text: 'Esecuzione su milestone. Codice pulito, design system coerente, feedback rapidi.' },
          { n: '04', tag: 'ARSOLVING', title: 'Risultati', text: 'KPI di business misurati. Il lavoro continua dopo il go-live, non finisce lì.' },
        ].map((step, i) => (
          <div class={`reveal delay-${i + 1} text-center`}>
            <div class="w-11 h-11 rounded-full border border-gold/45 flex items-center justify-center mx-auto mb-4">
              <span class="font-display text-gold text-[0.8rem]">{step.n}</span>
            </div>
            <span class="block text-[0.55rem] tracking-[0.24em] uppercase font-bold text-gold/75 mb-1.5">{step.tag}</span>
            <h4 class="font-heading font-semibold text-white text-[0.9rem] mb-2">{step.title}</h4>
            <p class="text-white/58 text-[0.78rem] leading-[1.65]">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- CTA -->
  <section class="py-20 bg-white border-t border-navy/12">
    <div class="max-w-3xl mx-auto px-6 text-center reveal">
      <h2 class="font-display uppercase text-navy leading-[0.92] mb-5"
          style="font-size: clamp(2rem, 4vw, 4rem);">
        Hai un progetto digitale?
      </h2>
      <p class="text-navy/78 text-[1rem] leading-[1.8] mb-10">
        Sito, brand, grafica o campagna: parlane con ARSOLVING per il brief,
        oppure esplora il lavoro di stà nel dettaglio.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={`${base}/contatti/`} class="btn-gold">Parliamone con ARSOLVING</a>
        <a href="https://stacomunicazionedesign.it" target="_blank" rel="noopener noreferrer"
           class="btn-outline-navy">
          Vai su stacomunicazionedesign.it
        </a>
      </div>
    </div>
  </section>

</Base>

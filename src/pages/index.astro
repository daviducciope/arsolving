---
import Base from '../layouts/Base.astro'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const method = [
  ['A', 'Analizza', 'Legge il contesto reale.'],
  ['R', 'Riduce', 'Taglia dispersioni e attriti.'],
  ['S', 'Struttura', 'Ordina processi e responsabilità.'],
  ['O', 'Opera', 'Porta metodo nell’esecuzione.'],
  ['L', 'Lega', 'Connette competenze diverse.'],
  ['V', 'Valorizza', 'Genera continuità e valore.'],
]

const dimensions = [
  ['Operativa', 'Spazi, strutture, attività quotidiane.', 'Facility / gestione / continuità', `${base}/services/`],
  ['Digitale', 'Identità, strumenti, presenza e linguaggi.', 'Brand / web / piattaforme', `${base}/digital/`],
  ['Strategica', 'Idee, iniziative, partnership e crescita.', 'Sviluppo / regia / opportunità', `${base}/projects/`],
]

const problems = [
  'Disordine operativo',
  'Identità debole',
  'Processi frammentati',
  'Crescita senza struttura',
  'Gestione discontinua',
]
---

<Base
  title="Home"
  description="ARSOLVING trasforma complessità operative, digitali e strategiche in sistemi chiari, integrati e gestibili."
>

  <!-- Hero -->
  <section id="mindset" class="home-hero relative min-h-[100svh] overflow-hidden bg-[#07101f] pt-24 lg:pt-28">
    <div class="stellar-field absolute inset-0 pointer-events-none"></div>
    <div class="hero-grid absolute inset-0 pointer-events-none"></div>
    <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_74%_42%,rgba(181,151,58,0.18),transparent_29%),radial-gradient(circle_at_32%_64%,rgba(77,107,160,0.24),transparent_34%)]"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-10 min-h-[calc(100svh-7rem)] grid grid-cols-1 lg:grid-cols-[1fr_0.82fr] gap-10 lg:gap-16 items-center">
      <div class="relative z-10 max-w-4xl py-12 lg:py-20">
        <div class="animate-fade-in-up inline-flex items-center gap-3 rounded-full border border-gold/25 bg-white/[0.035] px-4 py-2 text-gold text-[0.68rem] tracking-[0.22em] uppercase mb-7"
             style="animation-delay:0.05s;">
          <span class="h-1.5 w-1.5 rounded-full bg-gold shadow-[0_0_18px_rgba(181,151,58,0.9)]"></span>
          Arsolv' Mindset
        </div>

        <h1 class="animate-fade-in-up font-heading font-semibold text-white leading-[0.92] max-w-[11ch] mb-7"
            style="font-size: clamp(4.1rem, 10vw, 9.5rem); animation-delay:0.16s;">
          Caos. Metodo. Sistema.
        </h1>

        <p class="animate-fade-in-up text-[1.05rem] md:text-[1.2rem] text-white/68 leading-[1.7] max-w-2xl mb-9"
           style="animation-delay:0.28s;">
          Arsolving entra dove tutto è frammentato e costruisce una regia unica: operativa, digitale, strategica.
        </p>

        <div class="animate-fade-in-up flex flex-col sm:flex-row gap-3 sm:gap-4 mb-10"
             style="animation-delay:0.4s;">
          <a href={`${base}/contatti/`}
             class="inline-flex justify-center px-7 py-4 bg-gold text-navy-dark text-[0.78rem] font-bold tracking-[0.16em] uppercase rounded hover:bg-gold-light transition-all duration-200 hover:-translate-y-0.5">
            Avvia analisi
          </a>
          <a href="#arsolv"
             class="inline-flex justify-center px-7 py-4 border border-white/24 text-white text-[0.78rem] font-semibold tracking-[0.16em] uppercase rounded hover:border-gold/60 hover:text-gold transition-all duration-200">
            Vedi il metodo
          </a>
        </div>

        <div class="animate-fade-in-up grid grid-cols-3 gap-3 max-w-xl" style="animation-delay:0.52s;">
          {['Problema', 'Regia', 'Sistema'].map((item, i) => (
            <div class="border border-white/10 bg-white/[0.035] rounded p-4">
              <div class="text-[0.62rem] tracking-[0.18em] uppercase text-gold/70 mb-2">0{i + 1}</div>
              <div class="text-[0.82rem] font-semibold text-white">{item}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="relative hidden lg:flex items-center justify-center min-h-[560px]">
        <div class="orbit-system">
          <div class="orbit-ring orbit-ring-1"></div>
          <div class="orbit-ring orbit-ring-2"></div>
          <div class="orbit-ring orbit-ring-3"></div>
          <div class="orbit-core">
            <img src={`${base}/logo.jpeg`} alt="ARSOLVING" />
          </div>
          {method.map((step, i) => (
            <div class={`orbit-node orbit-node-${i + 1}`}>
              <span>{step[0]}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Manifesto -->
  <section class="bg-white py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-18 items-start">
        <div class="reveal">
          <div class="text-gold text-[0.68rem] tracking-[0.24em] uppercase mb-5">Cambio di paradigma</div>
          <h2 class="font-heading font-semibold text-navy leading-[1.02] max-w-[12ch]"
              style="font-size: clamp(2.6rem, 5vw, 5.2rem);">
            Non siamo un catalogo.
          </h2>
        </div>

        <div class="reveal delay-2">
          <p class="text-[1.18rem] lg:text-[1.35rem] leading-[1.55] text-navy/72 mb-8">
            Partiamo dal problema, troviamo la struttura, coordiniamo le competenze. Il risultato non è una lista di servizi: è un sistema che funziona.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {['Meno frammentazione', 'Più controllo', 'Una sola regia'].map((item) => (
              <div class="bg-cream border border-gray-100 rounded p-5">
                <div class="h-1 w-10 bg-gold mb-5"></div>
                <p class="text-[0.92rem] font-semibold text-navy leading-snug">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Method -->
  <section id="arsolv" class="relative overflow-hidden bg-[#07101f] py-20 lg:py-28">
    <div class="stellar-field absolute inset-0 pointer-events-none opacity-80"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <div class="reveal mb-12 lg:mb-16 max-w-3xl">
        <div class="text-gold text-[0.68rem] tracking-[0.24em] uppercase mb-5">A.R.S.O.L.V.</div>
        <h2 class="font-heading font-semibold text-white leading-[1.02] mb-5"
            style="font-size: clamp(2.7rem, 6vw, 6rem);">
          Il metodo che mette ordine.
        </h2>
        <p class="text-[1rem] text-white/58 leading-[1.7] max-w-2xl">
          Sei passaggi. Una direzione. Dalla complessità grezza a una struttura gestibile nel tempo.
        </p>
      </div>

      <div class="method-strip">
        {method.map((step, i) => (
          <div class={`reveal delay-${Math.min(i + 1, 5)} method-tile`}>
            <div class="method-letter">{step[0]}</div>
            <h3>{step[1]}</h3>
            <p>{step[2]}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Dimensions -->
  <section id="cosa-risolviamo" class="bg-cream py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="reveal flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-12">
        <div>
          <div class="text-gold text-[0.68rem] tracking-[0.24em] uppercase mb-5">Cosa risolviamo</div>
          <h2 class="font-heading font-semibold text-navy leading-[1.02] max-w-[11ch]"
              style="font-size: clamp(2.7rem, 5.6vw, 5.8rem);">
            Tre campi. Una regia.
          </h2>
        </div>
        <p class="text-[1rem] text-navy/58 leading-[1.7] max-w-xl">
          Non separiamo i problemi in reparti. Li leggiamo come parti dello stesso sistema.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-12">
        {dimensions.map((dimension, i) => (
          <a href={dimension[3]}
             class={`solution-panel reveal delay-${i + 1} group`}>
            <div class="flex items-start justify-between mb-12">
              <span class="text-[0.68rem] tracking-[0.22em] uppercase text-gold">0{i + 1}</span>
              <span class="text-gold/60 group-hover:text-gold group-hover:translate-x-1 transition-all">→</span>
            </div>
            <h3>{dimension[0]}</h3>
            <p>{dimension[1]}</p>
            <div>{dimension[2]}</div>
          </a>
        ))}
      </div>

      <div class="reveal delay-2 flex flex-wrap gap-3">
        {problems.map((problem) => (
          <span class="rounded-full border border-navy/10 bg-white px-4 py-2 text-[0.78rem] font-semibold text-navy/62">
            {problem}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- System flow -->
  <section id="soluzioni-applicate" class="bg-white py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="system-flow reveal">
        <div>
          <div class="text-gold text-[0.68rem] tracking-[0.24em] uppercase mb-5">Da problema a sistema</div>
          <h2 class="font-heading font-semibold text-navy leading-[1.04] mb-6"
              style="font-size: clamp(2.5rem, 5.2vw, 5.4rem);">
            La soluzione non è l’intervento. È la struttura.
          </h2>
          <p class="text-[1.02rem] text-navy/58 leading-[1.7] max-w-2xl">
            Analisi, metodo, esecuzione e continuità diventano un unico percorso.
          </p>
        </div>

        <div class="flow-steps">
          {['Contesto', 'Metodo', 'Sistema', 'Continuità'].map((item, i) => (
            <div>
              <span>0{i + 1}</span>
              <strong>{item}</strong>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="relative overflow-hidden bg-[#07101f] py-20 lg:py-28">
    <div class="stellar-field absolute inset-0 pointer-events-none"></div>
    <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_50%_100%,rgba(181,151,58,0.16),transparent_42%)]"></div>

    <div class="relative max-w-4xl mx-auto px-6 text-center reveal">
      <div class="text-gold text-[0.68rem] tracking-[0.24em] uppercase mb-6">Avvio analisi</div>
      <h2 class="font-heading font-semibold text-white leading-[1.02] mb-7"
          style="font-size: clamp(3rem, 7vw, 7rem);">
        Portaci il caos.
      </h2>
      <p class="text-[1.05rem] text-white/60 leading-[1.7] max-w-2xl mx-auto mb-9">
        Lo leggiamo, lo ordiniamo e costruiamo il sistema più adatto.
      </p>
      <a href={`${base}/contatti/`}
         class="inline-flex px-8 py-4 bg-gold text-navy-dark text-[0.8rem] font-bold tracking-[0.16em] uppercase rounded hover:bg-gold-light transition-all duration-200 hover:-translate-y-0.5">
        Avvia il confronto
      </a>
    </div>
  </section>

</Base>

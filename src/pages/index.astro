---
import Base from '../layouts/Base.astro'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<Base title="Home">

  <!-- ══════════════════════════════════
       1 · HERO
  ══════════════════════════════════ -->
  <section class="relative min-h-screen flex items-center bg-navy-dark overflow-hidden">

    <!-- Background grid -->
    <div class="absolute inset-0 pointer-events-none"
         style="background-image: linear-gradient(rgba(181,151,58,0.038) 1px, transparent 1px),
                                  linear-gradient(90deg, rgba(181,151,58,0.038) 1px, transparent 1px);
                background-size: 68px 68px;">
    </div>
    <!-- Radial glow -->
    <div class="absolute inset-0 pointer-events-none"
         style="background: radial-gradient(ellipse 60% 70% at 50% 40%, rgba(181,151,58,0.055) 0%, transparent 65%);">
    </div>

    <div class="relative max-w-4xl mx-auto px-6 lg:px-10 py-32 text-center w-full">

      <!-- Logo -->
      <div class="animate-fade-in-up mb-10" style="animation-delay:0.1s;">
        <div class="w-20 h-20 mx-auto rounded-full overflow-hidden ring-1 ring-gold/20 shadow-2xl
                    animate-float">
          <img src={`${base}/logo.jpeg`} alt="ARSOLVING" class="w-full h-full object-contain bg-white" />
        </div>
      </div>

      <!-- Name -->
      <div class="animate-fade-in-up" style="animation-delay:0.25s;">
        <h1 class="font-heading font-semibold tracking-[0.08em] leading-none mb-3"
            style="font-size: clamp(3.5rem, 8vw, 6.5rem);">
          <span class="font-bold text-white">AR</span><span class="font-light text-gold">SOLVING</span>
        </h1>
        <p class="text-[0.72rem] tracking-[0.32em] uppercase text-white/35 mb-10">
          Premium Multiservice Group
        </p>
      </div>

      <!-- Separator -->
      <div class="animate-fade-in-up flex items-center justify-center gap-4 mb-10"
           style="animation-delay:0.4s;">
        <span class="block w-12 h-px bg-gold/40"></span>
        <span class="block w-1.5 h-1.5 rounded-full bg-gold/60"></span>
        <span class="block w-12 h-px bg-gold/40"></span>
      </div>

      <!-- Claim -->
      <div class="animate-fade-in-up mb-4" style="animation-delay:0.5s;">
        <h2 class="font-heading font-medium text-white leading-[1.2]"
            style="font-size: clamp(1.6rem, 3.5vw, 2.4rem);">
          Visione strutturata. Soluzioni concrete.
        </h2>
      </div>

      <div class="animate-fade-in-up mb-12" style="animation-delay:0.6s;">
        <p class="text-[1rem] text-white/48 leading-[1.75] max-w-xl mx-auto">
          Dall'operatività sul territorio ai progetti digitali e strategici.
        </p>
      </div>

      <!-- CTAs -->
      <div class="animate-fade-in-up flex flex-wrap items-center justify-center gap-4"
           style="animation-delay:0.7s;">
        <a href={`${base}/il-gruppo/`}
           class="px-7 py-3.5 bg-gold text-navy-dark text-[0.78rem] font-semibold
                  tracking-[0.14em] uppercase rounded
                  hover:bg-gold-light transition-all duration-200 hover:-translate-y-0.5">
          Scopri il gruppo
        </a>
        <a href={`${base}/services/`}
           class="px-7 py-3.5 border border-white/20 text-white text-[0.78rem]
                  tracking-[0.14em] uppercase rounded
                  hover:border-gold/50 hover:text-gold transition-all duration-200">
          Esplora i servizi
        </a>
        <a href={`${base}/contatti/`}
           class="px-7 py-3.5 border border-white/20 text-white text-[0.78rem]
                  tracking-[0.14em] uppercase rounded
                  hover:border-gold/50 hover:text-gold transition-all duration-200">
          Contattaci
        </a>
      </div>

    </div>

    <!-- Scroll hint -->
    <div class="animate-bounce-scroll absolute bottom-10 left-1/2">
      <div class="flex flex-col items-center gap-2.5">
        <span class="text-[0.58rem] tracking-[0.22em] uppercase text-white/25">Scroll</span>
        <svg class="w-3.5 h-3.5 text-white/25" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/>
        </svg>
      </div>
    </div>

  </section>


  <!-- ══════════════════════════════════
       2 · CHI SIAMO BREVE
  ══════════════════════════════════ -->
  <section class="py-28 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">

        <div class="reveal">
          <div class="flex items-center gap-3 text-gold text-[0.68rem] tracking-[0.24em] uppercase mb-6">
            <span class="block w-7 h-px bg-gold"></span>Chi siamo
          </div>
          <h2 class="font-heading font-semibold text-navy leading-[1.15]"
              style="font-size: clamp(2rem, 3.5vw, 2.8rem);">
            Un gruppo.<br />Più competenze.
          </h2>
        </div>

        <div class="reveal delay-2">
          <p class="text-[1.02rem] text-gray-500 leading-[1.85] mb-6">
            ARSOLVING è un Premium Multiservice Group fondato sulla convinzione che le
            aziende e i progetti complessi meritano un partner, non un fornitore.
          </p>
          <p class="text-[1.02rem] text-gray-500 leading-[1.85] mb-8">
            Operiamo su due fronti complementari — servizi operativi sul territorio e
            soluzioni digitali e strategiche — con la stessa metodologia: ascolto,
            progettazione, esecuzione, risultati misurabili.
          </p>
          <a href={`${base}/il-gruppo/`}
             class="inline-flex items-center gap-2.5 text-[0.78rem] tracking-[0.14em] uppercase
                    text-navy font-medium hover:text-gold transition-colors duration-200 group">
            Leggi la nostra storia
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform duration-200"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════
       3 · LE DUE DIVISIONI
  ══════════════════════════════════ -->
  <section class="py-28 bg-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">

      <div class="reveal mb-16 text-center">
        <div class="flex items-center justify-center gap-3 text-gold text-[0.68rem] tracking-[0.24em] uppercase mb-5">
          <span class="block w-7 h-px bg-gold"></span>Le divisioni<span class="block w-7 h-px bg-gold"></span>
        </div>
        <h2 class="font-heading font-semibold text-navy leading-[1.15]"
            style="font-size: clamp(2rem, 3.5vw, 2.8rem);">
          Due anime. Un solo gruppo.
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- Services -->
        <a href={`${base}/services/`}
           class="division-card reveal delay-1 group block bg-navy rounded-lg p-10 lg:p-12
                  hover:bg-navy-light transition-colors duration-300 border border-navy/0
                  hover:border-gold/10">
          <div class="flex items-center justify-between mb-8">
            <div class="w-12 h-12 rounded border border-gold/25 flex items-center justify-center text-gold">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
            </div>
            <svg class="w-5 h-5 text-gold/30 group-hover:text-gold/60 group-hover:translate-x-1 transition-all duration-300"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </div>

          <div class="text-[0.65rem] tracking-[0.22em] uppercase text-gold/60 mb-3">Arsolving</div>
          <h3 class="font-heading font-semibold text-white text-[1.9rem] leading-none mb-5">Services</h3>
          <p class="text-[0.92rem] text-white/50 leading-[1.8] mb-8">
            Servizi integrati per edifici, facility management, cura degli spazi
            e gestione operativa sul territorio. Un presidio professionale e affidabile.
          </p>

          <div class="flex flex-wrap gap-2">
            {['Edifici & Condomini','Isole ecologiche','Pulizie','Verde','Manutenzioni'].map(t => (
              <span class="text-[0.62rem] tracking-wide uppercase text-white/30 border border-white/12 px-3 py-1 rounded-full">
                {t}
              </span>
            ))}
          </div>
        </a>

        <!-- Digital -->
        <a href={`${base}/digital/`}
           class="division-card reveal delay-2 group block bg-navy-dark rounded-lg p-10 lg:p-12
                  hover:bg-navy transition-colors duration-300 border border-gold/8
                  hover:border-gold/20">
          <div class="flex items-center justify-between mb-8">
            <div class="w-12 h-12 rounded border border-gold/25 flex items-center justify-center text-gold">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <svg class="w-5 h-5 text-gold/30 group-hover:text-gold/60 group-hover:translate-x-1 transition-all duration-300"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </div>

          <div class="text-[0.65rem] tracking-[0.22em] uppercase text-gold/60 mb-3">Arsolving</div>
          <h3 class="font-heading font-semibold text-white text-[1.9rem] leading-none mb-5">Digital</h3>
          <p class="text-[0.92rem] text-white/50 leading-[1.8] mb-8">
            Comunicazione, branding, sviluppo web, applicazioni e marketing digitale.
            Una regia strategica unica per la tua presenza online e la tua identità di marca.
          </p>

          <div class="flex flex-wrap gap-2">
            {['Branding','Web & App','Marketing','Comunicazione','Consulenza'].map(t => (
              <span class="text-[0.62rem] tracking-wide uppercase text-white/30 border border-white/12 px-3 py-1 rounded-full">
                {t}
              </span>
            ))}
          </div>
        </a>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════
       4 · METODO
  ══════════════════════════════════ -->
  <section class="py-28 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16 items-start mb-20">
        <div class="reveal">
          <div class="flex items-center gap-3 text-gold text-[0.68rem] tracking-[0.24em] uppercase mb-6">
            <span class="block w-7 h-px bg-gold"></span>Il nostro metodo
          </div>
          <h2 class="font-heading font-semibold text-navy leading-[1.15]"
              style="font-size: clamp(2rem, 3.2vw, 2.6rem);">
            Non improvvisiamo.<br />Progettiamo.
          </h2>
        </div>
        <div class="lg:col-span-2 reveal delay-2 flex items-end">
          <p class="text-[1rem] text-gray-400 leading-[1.85]">
            Ogni mandato inizia dall'ascolto e termina con la misurazione dei risultati.
            In mezzo: metodo, precisione e responsabilità condivisa.
          </p>
        </div>
      </div>

      <!-- Steps -->
      <div class="relative">
        <!-- Connector line desktop -->
        <div class="step-connector hidden lg:block"></div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-6">

          {[
            {
              n: '01', title: 'Ascolto',
              text: 'Analizziamo il contesto, le esigenze e gli obiettivi senza presupposti. La comprensione viene prima di qualsiasi soluzione.'
            },
            {
              n: '02', title: 'Progettazione',
              text: 'Costruiamo soluzioni su misura, documentate e condivise prima dell\'esecuzione. Niente viene lasciato all\'improvvisazione.'
            },
            {
              n: '03', title: 'Esecuzione',
              text: 'Lavoriamo con precisione, rispettando tempi e standard qualitativi. La continuità operativa del cliente non viene mai compromessa.'
            },
            {
              n: '04', title: 'Monitoraggio',
              text: 'Misuriamo i risultati e ottimizziamo nel tempo. Il lavoro non finisce con la consegna: finisce quando i KPI sono raggiunti.'
            },
          ].map((step, i) => (
            <div class={`reveal delay-${i+1} flex flex-col items-center text-center group`}>
              <div class="w-[52px] h-[52px] rounded-full border border-gold/40 flex items-center
                          justify-center mb-6 relative z-10 bg-white
                          group-hover:bg-gold group-hover:border-gold transition-all duration-300">
                <span class="font-heading text-[0.85rem] text-gold group-hover:text-navy-dark
                             transition-colors duration-300 font-semibold">{step.n}</span>
              </div>
              <h4 class="text-[0.92rem] font-semibold text-navy mb-3">{step.title}</h4>
              <p class="text-[0.82rem] text-gray-400 leading-[1.7]">{step.text}</p>
            </div>
          ))}

        </div>
      </div>

    </div>
  </section>


  <!-- ══════════════════════════════════
       5 · PROJECTS PREVIEW
  ══════════════════════════════════ -->
  <section class="py-24 bg-navy relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none"
         style="background: radial-gradient(ellipse 70% 60% at 30% 50%, rgba(181,151,58,0.05) 0%, transparent 60%);"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <div class="reveal">
          <div class="flex items-center gap-3 text-gold text-[0.68rem] tracking-[0.24em] uppercase mb-6">
            <span class="block w-7 h-px bg-gold"></span>Projects & Ventures
          </div>
          <h2 class="font-heading font-semibold text-white leading-[1.15] mb-6"
              style="font-size: clamp(1.8rem, 3.2vw, 2.6rem);">
            Non solo esecuzione.<br />Anche sviluppo.
          </h2>
          <p class="text-[1rem] text-white/48 leading-[1.85] mb-8">
            ARSOLVING valuta nuove opportunità, costruisce iniziative e affianca
            chi vuole sviluppare progetti ambiziosi con metodo e visione di lungo periodo.
          </p>
          <a href={`${base}/projects/`}
             class="inline-flex items-center gap-3 text-[0.78rem] tracking-[0.14em] uppercase
                    text-gold hover:text-gold-light transition-colors duration-200 group font-medium">
            Esplora Projects
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>

        <div class="reveal delay-2 grid grid-cols-2 gap-4">
          {[
            { label: 'Analisi opportunità',   desc: 'Valutiamo la fattibilità di nuove iniziative con rigore analitico.' },
            { label: 'Partnership',           desc: 'Costruiamo relazioni con partner selezionati su obiettivi condivisi.' },
            { label: 'Sviluppo progetti',     desc: 'Accompagniamo le idee dalla fase embrionale all\'operatività.' },
            { label: 'Visione strategica',    desc: 'Ogni iniziativa è inserita in un disegno di crescita coerente.' },
          ].map(item => (
            <div class="bg-white/4 border border-white/8 rounded-lg p-5 hover:border-gold/20 transition-colors duration-200">
              <h4 class="text-[0.82rem] font-semibold text-white mb-2">{item.label}</h4>
              <p class="text-[0.76rem] text-white/38 leading-[1.65]">{item.desc}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════
       6 · SOSTANZA — brand operativo
  ══════════════════════════════════ -->
  <section class="py-16 bg-cream border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 reveal">

        <div class="flex items-start gap-6">
          <div class="w-px h-12 bg-gold/35 flex-shrink-0 mt-1 hidden md:block"></div>
          <div>
            <div class="text-[0.62rem] tracking-[0.22em] uppercase text-gray-400 mb-2">
              Brand operativo territoriale del gruppo
            </div>
            <div class="font-heading text-navy text-[1.3rem] tracking-wider mb-2">Sostanza</div>
            <p class="text-[0.85rem] text-gray-400 max-w-md leading-[1.75]">
              Presidio operativo dedicato alla gestione professionale dei rifiuti
              condominiali. Stessi standard qualitativi di ARSOLVING, presenza locale.
            </p>
          </div>
        </div>

        <a href="#"
           class="flex-shrink-0 text-[0.72rem] tracking-[0.14em] uppercase
                  text-navy border border-navy/25 px-6 py-3 rounded
                  hover:bg-navy hover:text-white transition-all duration-200">
          Vai a Sostanza →
        </a>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════
       7 · CTA FINALE
  ══════════════════════════════════ -->
  <section class="py-28 bg-navy-dark relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none"
         style="background: radial-gradient(ellipse 80% 60% at 50% 100%, rgba(181,151,58,0.06) 0%, transparent 65%);"></div>

    <div class="relative max-w-3xl mx-auto px-6 text-center reveal">
      <div class="flex items-center justify-center gap-3 text-gold text-[0.68rem] tracking-[0.24em] uppercase mb-6">
        <span class="block w-7 h-px bg-gold"></span>Inizia la conversazione<span class="block w-7 h-px bg-gold"></span>
      </div>
      <h2 class="font-heading font-semibold text-white leading-[1.2] mb-5"
          style="font-size: clamp(2rem, 4vw, 3rem);">
        Pronti quando lo sei tu.
      </h2>
      <p class="text-[1rem] text-white/45 leading-[1.8] mb-10">
        Raccontaci il tuo progetto o la sfida che stai affrontando.
        Il nostro team ti risponderà con un'analisi concreta, non con un preventivo generico.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={`${base}/contatti/`}
           class="px-9 py-4 bg-gold text-navy-dark text-[0.8rem] font-semibold
                  tracking-[0.16em] uppercase rounded
                  hover:bg-gold-light transition-all duration-200 hover:-translate-y-0.5">
          Contattaci
        </a>
        <a href={`${base}/il-gruppo/`}
           class="px-9 py-4 border border-white/18 text-white text-[0.8rem]
                  tracking-[0.16em] uppercase rounded
                  hover:border-gold/40 hover:text-gold transition-all duration-200">
          Scopri il gruppo
        </a>
      </div>
    </div>
  </section>

</Base>

---
import Base from '../layouts/Base.astro'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const cases = [
  {
    tag: 'Operativa · Segnaletica',
    problem: 'Un appalto pubblico bloccato. Materiali urgenti introvabili, grafica inesistente, scadenza imminente.',
    action: 'Fornitura completa reperita, comunicazione visiva progettata e consegnata prima della scadenza.',
    badge: '24h',
  },
  {
    tag: 'Digitale · Web',
    problem: "Un'attività commerciale stava aprendo senza alcuna presenza online. Zero materiali, zero tempo.",
    action: 'Sito completo progettato, sviluppato e pubblicato prima del giorno di apertura. Nessun ritardo.',
    badge: '48h',
  },
  {
    tag: 'Operativa · Facility',
    problem: 'Un edificio pubblico con un problema igienico irrisolto da mesi. Interventi parziali falliti.',
    action: 'Bonifica completa su più piani e sistema permanente di prevenzione attivato in due giorni.',
    badge: '2 gg',
  },
  {
    tag: 'Operativa · Eventi',
    problem: "Un evento sportivo di rilievo senza servizio di ristorazione all'ultimo momento. Organizzatori nel panico.",
    action: 'Allestimento food & beverage completo attivato in meno di 24 ore. Evento regolare.',
    badge: '1 gg',
  },
  {
    tag: 'Strategica · Brand',
    problem: "Un'idea commerciale concreta, ma nessuno strumento per realizzarla. Nessun locale, nessun brand.",
    action: 'Spazio trovato, allestito, fornitori ingaggiati, identità di brand creata. Da zero a operativo.',
    badge: '3 sett.',
  },
  {
    tag: 'Operativa · Sport',
    problem: 'Atleti in competizione paralimpica senza attrezzatura tecnica indispensabile. Urgenza assoluta.',
    action: 'Attrezzatura reperita e consegnata prima dell\'inizio della competizione. Gara regolare.',
    badge: 'Urgente',
  },
]

const areas = [
  {
    n: '01',
    label: 'Operativa',
    title: 'Sul campo in ore',
    desc: 'Pulizie, allestimenti, forniture, manutenzione, facility management, segnaletica, eventi, emergenze logistiche.',
    href: `${base}/services/`,
    items: ['Pulizie professionali', 'Allestimenti & eventi', 'Forniture urgenti', 'Facility management', 'Manutenzione edifici'],
  },
  {
    n: '02',
    label: 'Digitale',
    title: 'Online in giorni',
    desc: 'Siti web, brand identity, grafica, comunicazione strategica, marketing digitale. Dalla strategia al pixel.',
    href: `${base}/digital/`,
    items: ['Siti web & landing page', 'Brand identity & logo', 'Graphic design', 'Marketing digitale', 'Comunicazione strategica'],
  },
  {
    n: '03',
    label: 'Strategica',
    title: 'Costruiamo da zero',
    desc: 'Partnership, sviluppo iniziative, consulenza operativa, progettazione da zero. Dalla visione alla realtà.',
    href: `${base}/projects/`,
    items: ['Partnership & venture', 'Consulenza operativa', 'Progettazione spazi', 'Sviluppo business', 'Gestione progetti'],
  },
]

const method = [
  {
    n: '01', letter: 'A', word: 'Analizza',
    claim: 'Leggiamo il contesto reale, non quello dichiarato.',
    in: 'Una richiesta, spesso confusa.',
    out: 'Un quadro chiaro: vincoli, tempi, leve.',
  },
  {
    n: '02', letter: 'R', word: 'Riduce',
    claim: 'Tagliamo dispersioni, ridondanze e attriti inutili.',
    in: 'Tante variabili, tante priorità.',
    out: 'Le poche cose che contano davvero.',
  },
  {
    n: '03', letter: 'S', word: 'Struttura',
    claim: 'Ordiniamo processi, ruoli e responsabilità.',
    in: 'Caos operativo.',
    out: 'Sequenza chiara, ruoli definiti, scadenze.',
  },
  {
    n: '04', letter: 'O', word: 'Opera',
    claim: "Portiamo metodo nell'esecuzione, sul campo.",
    in: 'Un piano sulla carta.',
    out: 'Lavoro fatto. Niente ritardi, niente scuse.',
  },
  {
    n: '05', letter: 'L', word: 'Lega',
    claim: 'Connettiamo competenze, fornitori, persone diverse.',
    in: 'Specialisti scollegati.',
    out: 'Una squadra che parla la stessa lingua.',
  },
  {
    n: '06', letter: 'V', word: 'Valorizza',
    claim: 'Trasformiamo la soluzione in valore che dura nel tempo.',
    in: 'Un problema risolto.',
    out: 'Un sistema che continua a funzionare.',
  },
]
---

<Base
  title="Home"
  description="ARSOLVING — Qualsiasi problema: operativo, digitale, logistico, commerciale. Lo risolviamo. Oggi, non domani."
>

  <!-- ═══ HERO ═══ -->
  <section class="relative min-h-[65svh] lg:min-h-[75svh] bg-navy overflow-hidden flex flex-col justify-start pb-6 lg:pb-10 pt-[7.5rem]">
    <div class="absolute inset-0 pointer-events-none"
         style="background: radial-gradient(ellipse 70% 60% at 15% 80%, rgba(199,162,74,0.1) 0%, transparent 60%), radial-gradient(ellipse 40% 50% at 85% 20%, rgba(26,43,74,0.8) 0%, transparent 60%);"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-10 w-full">
      <!-- Headline -->
      <h1 class="animate-fade-in-up font-display text-white uppercase leading-[0.88] mb-5 lg:mb-10"
          style="font-size: clamp(3.45rem, 11.5vw, 13rem); animation-delay: 0.12s;">
        Qualsiasi<br />
        <span class="text-gold">problema.</span><br />
        Noi lo<br />
        <span class="text-gold">risolviamo!</span><br />
      </h1>

      <!-- Sub + CTAs -->
      <div class="animate-fade-in-up flex flex-col lg:flex-row items-start lg:items-end gap-5 lg:gap-16"
           style="animation-delay: 0.3s;">
        <p class="text-white/74 text-[1rem] lg:text-[1.1rem] leading-[1.75] max-w-[44ch]">
          ARSOLVING nasce da una <strong class="font-semibold text-white/82">capacità fuori dal comune</strong>:
          <strong class="font-semibold text-white/82">risolvere qualsiasi tipo di problema</strong> in
          <strong class="font-semibold text-white/82">qualsiasi contesto</strong>.
          <strong class="font-semibold text-white/82">Operativo, digitale, strategico</strong>,
          non importa la natura del problema <strong class="font-semibold text-white/82">noi lo risolviamo</strong>.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 flex-shrink-0">
          <a href={`${base}/contatti/`} class="btn-gold">Raccontaci il problema</a>
        </div>
      </div>
    </div>
  </section>


  


  <!-- ═══ INTERVENTI ═══ -->
  <section id="interventi" class="py-20 lg:py-28 bg-off-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">

      <div class="reveal mb-12 lg:mb-16">
        
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
          <h2 class="font-display uppercase text-navy leading-[0.92]"
              style="font-size: clamp(2.8rem, 6vw, 6rem);">
            Arsolv'<span class="text-gold">mindset.</span>
          </h2>
          <p class="text-navy/70 text-[0.9rem] leading-[1.7] max-w-[39ch] lg:text-right">
            La nostra attività nasce da una capacità concreta di problem solving.
            Questi sono alcuni casi reali.
          </p>
        </div>
      </div>

      <div class="cases-swipe grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="cases-track">
        {cases.map((c, i) => (
          <div class={`reveal delay-${(i % 3) + 1} case-card-v2 group`}>

            <!-- Header: tag -->
            <div class="flex items-center mb-6">
              <span class="case-tag">{c.tag}</span>
            </div>

            <!-- Problem block -->
            <div class="mb-5">
              <div class="flex items-center gap-2 mb-3">
                <span class="w-1.5 h-1.5 rounded-full bg-red-400/70 flex-shrink-0"></span>
                <span class="text-[0.55rem] tracking-[0.28em] uppercase font-bold text-navy/58">Problema</span>
              </div>
              <p class="font-heading font-semibold text-navy text-[1.05rem] leading-[1.4]">{c.problem}</p>
            </div>

            <!-- Divider: gold arrow -->
            <div class="flex items-center gap-3 my-5">
              <div class="h-px flex-1 bg-navy/12"></div>
              <div class="w-7 h-7 rounded-full border border-gold/50 flex items-center justify-center flex-shrink-0 group-hover:border-gold/70 group-hover:bg-gold/10 transition-all duration-300">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M1 6h10M7 2.5l3.5 3.5L7 9.5" stroke="#C7A24A" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <div class="h-px flex-1 bg-gold/32"></div>
            </div>

            <!-- Solution block -->
            <div>
              <div class="flex items-center gap-2 mb-3">
                <span class="w-1.5 h-1.5 rounded-full bg-gold flex-shrink-0"></span>
                <span class="text-[0.55rem] tracking-[0.28em] uppercase font-bold text-gold/90">Soluzione</span>
              </div>
              <p class="text-[0.88rem] text-navy/76 leading-[1.72]">{c.action}</p>
            </div>

          </div>
        ))}
      </div>

      <!-- Dots (mobile only) -->
      <div class="cases-dots" id="cases-dots">
        {cases.map((_, i) => (
          <button class={`cases-dot${i === 0 ? ' is-active' : ''}`} aria-label={`Caso ${i + 1}`} data-idx={i} />
        ))}
      </div>

    </div>
  </section>

  <script>
    const casesTrack = document.getElementById('cases-track')
    const casesDots  = document.getElementById('cases-dots')
    if (casesTrack && casesDots) {
      const cards = Array.from(casesTrack.querySelectorAll('.case-card-v2'))
      const dots  = Array.from(casesDots.querySelectorAll('.cases-dot'))

      const setActive = (idx: number) => {
        dots.forEach((d, i) => d.classList.toggle('is-active', i === idx))
      }

      let ticking = false
      casesTrack.addEventListener('scroll', () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(() => {
          const gap = 12
          const cardW = cards[0] ? cards[0].getBoundingClientRect().width + gap : 1
          setActive(Math.round(casesTrack.scrollLeft / cardW))
          ticking = false
        })
      }, { passive: true })

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          const gap = 12
          const cardW = cards[0] ? cards[0].getBoundingClientRect().width + gap : 1
          casesTrack.scrollTo({ left: i * cardW, behavior: 'smooth' })
        })
      })

      setActive(0)
    }
  </script>

  <!-- ═══ LE 3 AREE ═══ -->
  <section id="aree" class="py-20 lg:py-28 bg-navy-mid">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">

      <div class="reveal mb-12 lg:mb-16">
       
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
          <h2 class="font-display uppercase text-white leading-[0.92]"
              style="font-size: clamp(2.8rem, 6vw, 6rem);">
            Tre aree.<br />Un solo interlocutore.
          </h2>
          <p class="text-white/66 text-[0.9rem] leading-[1.7] max-w-[38ch] lg:text-right">
            Non siamo un'agenzia né un'impresa generalista. Siamo il partner che risolve, qualunque sia il settore.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-3">
        {areas.map((area, i) => (
          <a href={area.href} class={`reveal delay-${i + 1} area-panel group`}>
            <div class="flex items-start justify-between mb-6">
              <span class="text-gold/85 font-display text-[1.1rem] tracking-[0.3em]">{area.n}</span>
              <svg class="w-4 h-4 text-gold/55 group-hover:text-gold transition-colors duration-200"
                   fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10"/>
              </svg>
            </div>
            <span class="text-gold text-[0.68rem] tracking-[0.22em] uppercase font-bold mb-2 block">{area.label}</span>
            <h3 class="font-display text-white text-[2rem] leading-none uppercase mb-4">{area.title}</h3>
            <p class="text-white/66 text-[0.86rem] leading-[1.7] mb-6 flex-1">{area.desc}</p>
            <ul class="space-y-1.5">
              {area.items.map(item => (
                <li class="flex items-center gap-2.5 text-white/60 text-[0.78rem]">
                  <span class="w-1 h-1 rounded-full bg-gold flex-shrink-0"></span>
                  {item}
                </li>
              ))}
            </ul>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══ METODO ARSOLV ═══ -->
  <section id="arsolv" class="arsolv-section">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">

      <!-- Header -->
      <div class="reveal arsolv-header">
        <div>
          <p class="arsolv-eyebrow">A · R · S · O · L · V</p>
          <h2 class="font-display uppercase text-navy leading-[0.88]"
              style="font-size: clamp(3rem, 6vw, 5.5rem);">
            Il metodo dietro<br /><span class="text-gold">ogni soluzione.</span>
          </h2>
        </div>
        <p class="text-navy/60 text-[0.88rem] leading-[1.8] max-w-[38ch] lg:text-right">
          Non è improvvisazione, è metodo. Sei passaggi che trasformano
          qualsiasi problema in una soluzione strutturata e duratura.
        </p>
      </div>

      <!-- Rows -->
      <div class="arsolv-rows" id="arsolv-track">
        {method.map((step, i) => (
          <div class={`reveal delay-${Math.min(i + 1, 5)} arsolv-row group`}>
            <span class="arsolv-idx">{step.n}</span>
            <div class="arsolv-body">
              <h3 class="arsolv-word">{step.word}</h3>
              <p class="arsolv-claim">{step.claim}</p>
              <div class="arsolv-flow">
                <div class="arsolv-flow-col arsolv-flow-in">
                  <span class="arsolv-flow-label">Cosa entra</span>
                  <span class="arsolv-flow-text">{step.in}</span>
                </div>
                <div class="arsolv-flow-arrow" aria-hidden="true">
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none">
                    <path d="M1 6h10M7 2.5l3.5 3.5L7 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <div class="arsolv-flow-col arsolv-flow-out">
                  <span class="arsolv-flow-label">Cosa esce</span>
                  <span class="arsolv-flow-text">{step.out}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Dots (mobile only) -->
      <div class="arsolv-dots" id="arsolv-dots">
        {method.map((_, i) => (
          <button class={`arsolv-dot${i === 0 ? ' is-active' : ''}`} aria-label={`Step ${i + 1}`} data-idx={i} />
        ))}
      </div>


    </div>
  </section>

  <script>
    const track = document.getElementById('arsolv-track')
    const dotsEl = document.getElementById('arsolv-dots')
    if (track && dotsEl) {
      const cards = Array.from(track.querySelectorAll('.arsolv-row'))
      const dots  = Array.from(dotsEl.querySelectorAll('.arsolv-dot'))

      const setActive = (idx: number) => {
        cards.forEach((c, i) => c.classList.toggle('is-snapped', i === idx))
        dots.forEach((d, i)  => d.classList.toggle('is-active',  i === idx))
      }

      // Scroll → update active
      let ticking = false
      track.addEventListener('scroll', () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(() => {
          const gap = 12 // 0.75rem
          const cardW = cards[0] ? cards[0].getBoundingClientRect().width + gap : 1
          setActive(Math.round(track.scrollLeft / cardW))
          ticking = false
        })
      }, { passive: true })

      // Dots → scroll to card
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          const gap = 12
          const cardW = cards[0] ? cards[0].getBoundingClientRect().width + gap : 1
          track.scrollTo({ left: i * cardW, behavior: 'smooth' })
        })
      })

      setActive(0)
    }
  </script>



  <!-- ═══ CTA FINALE ═══ -->
  <section class="relative overflow-hidden bg-navy py-24 lg:py-32">
    <div class="hero-grid absolute inset-0 pointer-events-none opacity-60"></div>
    <div class="absolute inset-0 pointer-events-none"
         style="background: radial-gradient(ellipse 60% 80% at 50% 110%, rgba(199,162,74,0.12) 0%, transparent 60%);"></div>

    <div class="relative max-w-4xl mx-auto px-6 text-center reveal">
      
      <h2 class="font-display uppercase text-white leading-[0.88] mb-8"
          style="font-size: clamp(3.5rem, 9vw, 9rem);">
        Hai un<br /><span class="text-gold">problema?</span>
      </h2>
      <p class="text-white/72 text-[1rem] leading-[1.75] max-w-[38ch] mx-auto mb-10">
        Descrivici la situazione, anche se è complicata da spiegare.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={`${base}/contatti/`} class="btn-gold">Raccontaci il problema</a>
      </div>
    </div>
  </section>

</Base>

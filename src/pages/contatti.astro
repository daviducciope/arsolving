---
import Base from '../layouts/Base.astro'
---

<Base title="Contatti"
      description="Racconta ad ARSOLVING il problema da risolvere e avvia una richiesta di analisi.">

  <section class="contact-lab relative overflow-hidden bg-[#07101f] pt-32 pb-20 lg:pt-40 lg:pb-28">
    <div class="stellar-field absolute inset-0 pointer-events-none"></div>
    <div class="hero-grid absolute inset-0 pointer-events-none"></div>
    <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_80%_24%,rgba(181,151,58,0.18),transparent_32%),radial-gradient(circle_at_20%_80%,rgba(77,107,160,0.22),transparent_34%)]"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-16 items-start">
        <div class="reveal lg:sticky lg:top-32">
          <div class="inline-flex items-center gap-3 rounded-full border border-gold/25 bg-white/[0.035] px-4 py-2 text-gold text-[0.68rem] tracking-[0.22em] uppercase mb-7">
            <span class="h-1.5 w-1.5 rounded-full bg-gold shadow-[0_0_18px_rgba(181,151,58,0.9)]"></span>
            Avvio analisi
          </div>

          <h1 class="font-heading font-semibold text-white leading-[0.98] mb-7"
              style="font-size: clamp(3.2rem, 7vw, 7rem);">
            Raccontaci il problema.
          </h1>

          <p class="text-[1.08rem] text-white/62 leading-[1.7] max-w-xl mb-10">
            Non mandare una richiesta generica. Portaci il contesto: cosa non funziona, cosa vuoi ottenere, cosa oggi blocca il sistema.
          </p>

          <div class="contact-signal">
            <div>
              <span>01</span>
              <strong>Leggiamo</strong>
              <p>Capire prima di proporre.</p>
            </div>
            <div>
              <span>02</span>
              <strong>Ordiniamo</strong>
              <p>Priorità, ruoli, direzione.</p>
            </div>
            <div>
              <span>03</span>
              <strong>Costruiamo</strong>
              <p>Un percorso attuabile.</p>
            </div>
          </div>
        </div>

        <div class="reveal delay-2">
          <form id="contact-form" class="analysis-form">
            <div class="analysis-form-head">
              <span>Diagnosi iniziale</span>
              <h2>Mettiamo a fuoco il contesto.</h2>
            </div>

            <div class="form-row">
              <label>
                <span>Nome</span>
                <input type="text" name="nome" placeholder="Nome e cognome" required />
              </label>
              <label>
                <span>Realtà</span>
                <input type="text" name="azienda" placeholder="Azienda / progetto" />
              </label>
            </div>

            <div class="form-row">
              <label>
                <span>Email</span>
                <input type="email" name="email" placeholder="nome@azienda.it" required />
              </label>
              <label>
                <span>Telefono</span>
                <input type="tel" name="telefono" placeholder="+39" />
              </label>
            </div>

            <fieldset>
              <legend>Che tipo di problema è?</legend>
              <div class="context-options">
                {['Operativo', 'Digitale', 'Strategico', 'Misto'].map((item, i) => (
                  <label>
                    <input type="radio" name="contesto" value={item.toLowerCase()} checked={i === 0} />
                    <span>{item}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <label>
              <span>Il blocco principale</span>
              <textarea name="problema" rows="5" placeholder="Descrivi cosa non funziona, cosa rallenta o cosa va costruito meglio." required></textarea>
            </label>

            <div class="form-row">
              <label>
                <span>Stato attuale</span>
                <select name="struttura">
                  <option value="" disabled selected>Com’è messo oggi?</option>
                  <option value="zero">Si parte da zero</option>
                  <option value="parziale">Esiste qualcosa, ma è frammentato</option>
                  <option value="esistente">Esiste già una struttura</option>
                </select>
              </label>
              <label>
                <span>Priorità</span>
                <input type="text" name="priorita" placeholder="Tempistiche / urgenza / budget" />
              </label>
            </div>

            <button type="submit">Invia richiesta di analisi</button>

            <p class="form-note">
              Risposta via email da <strong>info@arsolving.com</strong>. Il collegamento a un backend form resta da configurare.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

</Base>

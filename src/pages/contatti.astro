---
import Base from '../layouts/Base.astro'
---

<Base title="Contatti"
      description="Raccontaci il problema — operativo, digitale o strategico. ARSOLVING risponde in 30 minuti.">

  <section class="relative overflow-hidden bg-navy pt-28 pb-20 lg:pt-36 lg:pb-28 min-h-screen">
    <div class="hero-grid absolute inset-0 pointer-events-none"></div>
    <div class="absolute inset-0 pointer-events-none"
         style="background: radial-gradient(ellipse 60% 70% at 80% 20%, rgba(199,162,74,0.1) 0%, transparent 50%), radial-gradient(ellipse 40% 50% at 15% 80%, rgba(26,43,74,0.8) 0%, transparent 60%);"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-[0.95fr_1.05fr] gap-12 lg:gap-20 items-start">

        <!-- Left col: info -->
        <div class="reveal lg:sticky lg:top-28">
          <div class="section-label mb-7">Avvia analisi</div>

          <h1 class="font-display uppercase text-white leading-[0.88] mb-7"
              style="font-size: clamp(3rem, 7vw, 7rem);">
            Raccontaci<br />il problema.
          </h1>

          <p class="text-[1rem] text-white/74 leading-[1.75] max-w-xl mb-10">
            Non serve un brief formale. Descrivi cosa non funziona, cosa vuoi ottenere
            o cosa blocca il sistema. In 30 minuti capiamo cosa fare.
          </p>

          <!-- Contact signal -->
          <div class="space-y-0 border border-white/14 mb-10">
            {[
              { n: '01', title: 'Ci scrivi', sub: 'Descrivi il problema anche in modo grezzo.' },
              { n: '02', title: 'Capiamo', sub: 'In 30 minuti valutiamo e proponiamo.' },
              { n: '03', title: 'Ci muoviamo', sub: 'Operativi dal primo giorno utile.' },
            ].map((s, i) => (
              <div class={`flex items-start gap-4 p-5 ${i > 0 ? 'border-t border-white/14' : ''} bg-white/[0.07]`}>
                <span class="font-display text-gold/85 text-[0.7rem] tracking-[0.3em] flex-shrink-0 mt-0.5">{s.n}</span>
                <div>
                  <strong class="block text-white font-heading font-semibold text-[0.95rem] mb-0.5">{s.title}</strong>
                  <p class="text-white/62 text-[0.8rem]">{s.sub}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Contact info -->
          <div class="space-y-3">
            <a href="mailto:info@arsolving.it"
               class="flex items-center gap-3 text-white/70 hover:text-white transition-colors text-[0.88rem]">
              <svg class="w-4 h-4 text-gold/78 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
              </svg>
              info@arsolving.it
            </a>
          </div>
        </div>

        <!-- Right col: form -->
        <div class="reveal delay-2">
          <form id="contact-form" class="analysis-form" novalidate>
            <div class="mb-7">
              <p class="text-gold/85 text-[0.62rem] tracking-[0.24em] uppercase font-bold mb-2">Diagnosi iniziale</p>
              <h2 class="font-display uppercase text-white leading-[0.92]"
                  style="font-size: clamp(1.8rem, 3.5vw, 3rem);">
                Mettiamo a fuoco il contesto.
              </h2>
            </div>

            <!-- Honeypot anti-spam (nascosto) -->
            <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
              <label>Sito web (lascia vuoto)
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div class="form-row">
              <label>
                <span>Nome</span>
                <input type="text" name="nome" placeholder="Nome e cognome" required />
              </label>
              <label>
                <span>Realtà</span>
                <input type="text" name="azienda" placeholder="Azienda / progetto" />
              </label>
            </div>

            <div class="form-row">
              <label>
                <span>Email</span>
                <input type="email" name="email" placeholder="nome@dominio.it" required />
              </label>
              <label>
                <span>Telefono</span>
                <input type="tel" name="telefono" placeholder="+39" />
              </label>
            </div>

            <fieldset>
              <legend>Che tipo di problema è?</legend>
              <div class="context-options">
                {['Operativo', 'Digitale', 'Strategico', 'Misto'].map((item, i) => (
                  <label>
                    <input type="radio" name="contesto" value={item.toLowerCase()} checked={i === 0} />
                    <span>{item}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <label>
              <span>Descrivi il problema</span>
              <textarea name="problema" rows="5"
                        placeholder="Cosa non funziona? Cosa vuoi ottenere? Cosa vi blocca oggi? Anche in modo grezzo va bene."
                        required></textarea>
            </label>

            <div class="form-row">
              <label>
                <span>Stato attuale</span>
                <select name="struttura">
                  <option value="" disabled selected>Com'è messo oggi?</option>
                  <option value="zero">Si parte da zero</option>
                  <option value="parziale">Esiste qualcosa, ma è frammentato</option>
                  <option value="esistente">Struttura esistente da migliorare</option>
                </select>
              </label>
              <label>
                <span>Urgenza / tempistiche</span>
                <input type="text" name="priorita" placeholder="Es: entro questa settimana" />
              </label>
            </div>

            <button type="submit">Invia richiesta di analisi →</button>

            <p id="form-feedback" class="form-feedback mt-4" role="status" aria-live="polite"></p>

            <p class="form-note mt-4">
              Risposta entro 30 minuti su <strong>info@arsolving.it</strong>
            </p>
          </form>
        </div>

      </div>
    </div>
  </section>

  <script is:inline define:vars={{ endpoint: import.meta.env.PUBLIC_CONTACT_ENDPOINT || '' }}>
    (function () {
      const form = document.getElementById('contact-form');
      if (!form) return;

      const feedback = document.getElementById('form-feedback');
      const btn = form.querySelector('button[type=submit]');
      const originalBtnText = btn ? btn.textContent : '';

      const ENDPOINT = endpoint || 'https://ks1sbfw0j8.execute-api.eu-central-1.amazonaws.com/contact';

      const setFeedback = (msg, type) => {
        if (!feedback) return;
        feedback.textContent = msg || '';
        feedback.dataset.state = type || '';
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!btn) return;

        const data = Object.fromEntries(new FormData(form).entries());
        if (!data.nome || !data.email || !data.problema) {
          setFeedback('Compila Nome, Email e Descrizione del problema.', 'error');
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Invio in corso…';
        setFeedback('', '');

        try {
          const res = await fetch(ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          const payload = await res.json().catch(() => ({}));
          if (!res.ok || !payload.success) {
            throw new Error(payload.error || 'Errore di rete. Riprova.');
          }
          form.reset();
          btn.textContent = 'Richiesta inviata ✓';
          btn.style.background = '#16a34a';
          setFeedback('Grazie! Ti rispondiamo entro 30 minuti.', 'success');
          setTimeout(() => {
            btn.textContent = originalBtnText;
            btn.disabled = false;
            btn.style.background = '';
          }, 4000);
        } catch (err) {
          console.error('contact form error:', err);
          btn.disabled = false;
          btn.textContent = originalBtnText;
          setFeedback(err.message || 'Si è verificato un errore. Riprova o scrivi a info@arsolving.it', 'error');
        }
      });
    })();
  </script>

  <style>
    .form-feedback { font-size: 0.85rem; min-height: 1.2em; color: rgba(255,255,255,0.65); }
    .form-feedback[data-state="error"]   { color: #fca5a5; }
    .form-feedback[data-state="success"] { color: #86efac; }
  </style>

</Base>

---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'

export interface Props {
  title: string
  description?: string
  noindex?: boolean
  socialImage?: string
  socialImageAlt?: string
}

const {
  title,
  description = 'ARSOLVING — Qualsiasi problema. Noi lo risolviamo. Operativi, digitali e strategici.',
  noindex = false,
  socialImage = "/og-image.png",
  socialImageAlt
} = Astro.props

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const siteUrl = 'https://arsolving.it'
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href
const pageTitle = title === 'Home'
  ? 'ARSOLVING — Qualsiasi problema. Noi lo risolviamo.'
  : `${title} — ARSOLVING`
const ogImage = new URL(socialImage, siteUrl).href
---

<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalURL} />
  <!-- Favicon & App Icons (Google Search & Browsers) -->
  <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" type="image/png" sizes="48x48" href={`${base}/favicon-48x48.png`} />
  <link rel="icon" type="image/png" sizes="96x96" href={`${base}/favicon-96x96.png`} />
  <link rel="icon" type="image/png" sizes="192x192" href={`${base}/favicon-192x192.png`} />
  <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ARSOLVING" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  {socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
  <meta property="og:locale" content="it_IT" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}

  <!-- JSON-LD Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "ARSOLVING",
    "alternateName": "ARSOLVING Multiservice Group",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/logo_arsolving.png`,
      "width": 6250,
      "height": 2084
    },
    "image": `${siteUrl}/og-image.png`,
    "description": "Qualsiasi problema: operativo, digitale, logistico, commerciale. ARSOLVING lo risolve.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Strada della Bonifica 48/1",
      "addressLocality": "Pescara",
      "postalCode": "65129",
      "addressRegion": "PE",
      "addressCountry": "IT"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@arsolving.it",
      "contactType": "customer service",
      "availableLanguage": "Italian"
    }
  })} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-LCX5EW19NM"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-LCX5EW19NM');
  </script>
</head>
<body class="bg-off-white text-navy overflow-x-hidden">
  <a href="#main-content" class="skip-link">Vai al contenuto</a>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <script src="../scripts/reveal.js"></script>
</body>
</html>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.65rem 1rem;
    background: var(--color-off-white);
    color: var(--color-navy);
    transform: translateY(-200%);
  }
  .skip-link:focus { transform: none; }
</style>

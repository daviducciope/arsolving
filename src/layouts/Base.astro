---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'

export interface Props {
  title: string
  description?: string
}

const {
  title,
  description = 'ARSOLVING — Qualsiasi problema. Noi lo risolviamo. Operativi, digitali e strategici.'
} = Astro.props

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title === 'Home' ? "ARSOLVING — Qualsiasi problema. Noi lo risolviamo." : `${title} — ARSOLVING`}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={`${base}/logo_arsolving.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="bg-off-white text-navy overflow-x-hidden">
  <Navbar />
  <main>
    <slot />
  </main>
  <Footer />
  <script src="../scripts/reveal.js"></script>
</body>
</html>
